{
  "realm": "mzk",
  "enabled": true,
  "clients": [{
    "clientId": "vera",
    "name": "VERA local",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "secret": "{{ .Values.vera.localServices.keycloak.clientSecret }}",
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:8400/*"],
    "webOrigins": ["http://localhost:8400"],
    "protocolMappers": [{
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }]
  }],
  "groups": [{"name":"mzk-staff"},{"name":"mzk-curators"},{"name":"mzk-digitization"}],
  "users": [
    {"username":"staff","enabled":true,"email":"staff@example.org","emailVerified":true,"firstName":"MZK","lastName":"Staff","groups":["mzk-staff"],"credentials":[{"type":"password","value":"{{ .Values.vera.localServices.keycloak.staffPassword }}","temporary":false}]},
    {"username":"curator","enabled":true,"email":"curator@example.org","emailVerified":true,"firstName":"MZK","lastName":"Curator","groups":["mzk-curators"],"credentials":[{"type":"password","value":"{{ .Values.vera.localServices.keycloak.curatorPassword }}","temporary":false}]},
    {"username":"digitizer","enabled":true,"email":"digitizer@example.org","emailVerified":true,"firstName":"MZK","lastName":"Digitizer","groups":["mzk-digitization"],"credentials":[{"type":"password","value":"{{ .Values.vera.localServices.keycloak.digitizationPassword }}","temporary":false}]}
  ]
}
