# VITE_ values are included in browser code. Never put secrets here.
VITE_API_BASE_URL=/api
VITE_API_MODE=mock
VITE_API_PROXY_TARGET=http://127.0.0.1:8081
VITE_DEFAULT_LOCALE=cs
VITE_MOCK_USER=curator
# none, unavailable (every answer 503), data (all but the session and login 503), slow (1.5 s).
VITE_MOCK_FAULT=none
# fixtures, or volume (make seed-volume first)
VITE_MOCK_SEED=fixtures
# OBS-pipeline: the OpenTelemetry collector (make obs-up gives http://localhost:4318) and its
# ingestion key from HyperDX. Leave the endpoint empty to record nothing.
VITE_OTEL_ENDPOINT=
VITE_OTEL_KEY=
# Repeats the mock's fixture documents this many times, to try lists at volume.
VITE_MOCK_DOCUMENT_COPIES=1
