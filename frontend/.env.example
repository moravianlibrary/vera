# VITE_ values are included in browser code. Never put secrets here.
VITE_API_BASE_URL=/api
VITE_API_MODE=mock
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_DEFAULT_LOCALE=cs
VITE_MOCK_USER=curator
# Repeats the mock's fixture documents this many times, to try lists at volume.
VITE_MOCK_DOCUMENT_COPIES=1
