      "input": {
        "iteration": {
          "defects": [
            {
              "key": "k"
            }
          ],
          "verdicts": [
            {
              "defectKeys": ["k"],
              "verdict": "Denied"
            }
          ]
        }
      },
      "expected": "Denied"
