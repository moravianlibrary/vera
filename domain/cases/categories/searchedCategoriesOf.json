        "parentId": null
      },
      {
        "id": "period",
        "name": "Periodicals",
        "names": { "en": "Periodicals", "cs": "Periodika" },
        "parentId": "root"
      },
      {
        "id": "regional",
        "name": "Regional",
        "names": { "en": "Regional", "cs": "Regionální" },
