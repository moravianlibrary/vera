@startuml VERA - Add Documents Activity Diagram

|#pink|User|
start

:Take one DocumentAddition entity from queue;

:Find identifier in catalog records database;
if (Is document identifier found?) then (yes)
    if (Catalog record from database is too old?) then (yes)
        :Synchronize catalog record with catalog;
        if (Catalog record found in catalog?) then (no)
            :Mark catalog record as Unreachable;
            :Update state of DocumentAddition to CatalogRecordUnreachable;
        else (yes)
            :Update catalog record;
        endif
    endif
    :Retrieve catalog record from database;
else
    :Find identifier in catalog;
    if (Is document identifier found?) then (yes)
        :Retrieve catalog record;
        :Save all parseable identifiers;
    else (no)
        :Update state of DocumentAddition to CatalogRecordNotFound;
    endif
endif

if (Is catalog record available?) then (yes)
    
endif

if (Document Already Present in VERA?) then (yes)
    :Enter Document Identifier;
    if (All iterations of this document were extracted?) then (yes)
        :Add document;
'   else (no)
'     |#lightgray|Curator: Cancel digitalization proposal;
'     :Cancel digitalization proposal;
'   endif
' else (no)
'   #pink:User: Browse processed documents;
'   :Browse processed documents;
' endif
' |#lightblue|DocumentsManager|
' :Manage digitization process;
' if (Document declined?) then (yes)
'   |#lightblue|DocumentsManager: Decline proposal;
'   :Decline digitization proposal;
' else (no)
'   |#lightblue|DocumentsManager: Add already digitized document;
'   :Add already digitized document;
' endif
' |#lightgray|User|
' if (Document found?) then (yes)
'   :View document details;
' else (no)
'   :Cancel search;
' endif
stop

@enduml
