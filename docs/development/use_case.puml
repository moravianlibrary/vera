' Users

package "User Operations" {
    usecase "Login" as USR1 <<Already Implemented>>
    usecase "List users in the database" as USR2 <<Already Implemented>>
    usecase "List groups in Keycloak" as USR3 <<Planned>>
    usecase "List roles in Keycloak" as USR4 <<Planned>>
    usecase "List all possible permissions" as USR5 <<Planned>>
    usecase "Manage roles" as USR6 <<Already Implemented>>
    usecase "Save user client settings" as USR7 <<Already Implemented>>
    usecase "Define roles and groups in Keycloak from YAML config" as USR8 <<Planned>>
