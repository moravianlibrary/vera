    usecase "Create digitalization list (from Documents view)" as DL4 <<Already Implemented>>
    usecase "Add/Remove items to digitalization list" as DL5 <<Already Implemented>>
    usecase "Remove digitalization list" as DL6 <<Already Implemented>>
}

