@startuml VERA - Use Case Diagram

' Draw settings
left to right direction

!define ALREADY_IMPLEMENTED_COLOR #A0E88E
!define REIMPLEMENT_COLOR #F1E27C
!define PLANNED_COLOR #87CEFA
!define MAYBE_IN_FUTURE_COLOR #F08080

skinparam usecase {
    BackgroundColor<< Already Implemented >> ALREADY_IMPLEMENTED_COLOR
    BackgroundColor<< Reimplement >> REIMPLEMENT_COLOR
    BackgroundColor<< Planned >> PLANNED_COLOR
    BackgroundColor<< Maybe In Future >> MAYBE_IN_FUTURE_COLOR
}

' Legend
legend top right
  | <ALREADY_IMPLEMENTED_COLOR> | Already Implemented |
  | <REIMPLEMENT_COLOR>         | Reimplement     |
  | <PLANNED_COLOR>             | Planned             |
  | <MAYBE_IN_FUTURE_COLOR>     | Maybe In Future     |
endlegend

' Documents

actor User
actor Curator
actor DigitizationManager

Curator <|-- DigitizationManager

package "Adding Documents" {
    usecase "Search through catalog" as DOC_ADD1 <<Planned>>
    usecase "Choose identifier from search results" as DOC_ADD2 <<Planned>>
    usecase "Find document by identifier" as DOC_ADD3 <<Already Implemented>>
    usecase "Propose document for digitalization" as DOC_ADD4 <<Maybe In Future>>
    usecase "Cancel digitalization proposal" as DOC_ADD5 <<Maybe In Future>>
    usecase "Add document for digitalization" as DOC_ADD6 <<Already Implemented>>
    usecase "Select specific unit to add/propose" as DOC_ADD7 <<Already Implemented>>
    usecase "Browse processed added/proposed documents" as DOC_ADD8 <<Already Implemented>>
    usecase "Add already digitized document" as DOC_ADD9 <<Planned>>
    usecase "Add document again (if processed before)" as DOC_ADD10 <<Planned>>
    usecase "Set document page count" as DOC_ADD11 <<Already Implemented>>
}

package "Managing Digitization" {
    usecase "Decline digitization proposal" as DIGI_MAN1 <<Planned>>
    usecase "Cancel the decline of document digitization proposal" as DIGI_MAN2 <<Planned>>
    usecase "Decline digitization" as DIGI_MAN3 <<Planned>>
    usecase "Cancel digitization decline" as DIGI_MAN4 <<Planned>>
}

package "Reading Documents" {
    usecase "Search for documents (based on ownership permission)" as DOC_READ1 <<Already Implemented>>
    usecase "View document details" as DOC_READ2 <<Already Implemented>>
}

package "Editing Documents" {
    usecase "Update document category" as DOC_EDIT1 <<Already Implemented>>
    usecase "Update extraction priority" as DOC_EDIT2 <<Already Implemented>>
    usecase "Update manual page count" as DOC_EDIT3 <<Already Implemented>>
    usecase "Reindex document" as DOC_EDIT4 <<Already Implemented>>
    usecase "Synchronize digitization state" as DOC_EDIT5 <<Already Implemented>>
    usecase "Synchronize from catalog" as DOC_EDIT6 <<Already Implemented>>
    usecase "Archive document" as DOC_EDIT7 <<Planned>>
    usecase "Remove document" as DOC_EDIT8 <<Reimplement>>
}

User --> DOC_ADD1
User --> DOC_ADD2
User --> DOC_ADD3
User --> DOC_ADD4
User --> DOC_ADD7
User --> DOC_ADD8
User --> DOC_READ1
User --> DOC_READ2

Curator --> DOC_ADD1
Curator --> DOC_ADD2
Curator --> DOC_ADD3
Curator --> DOC_ADD6
Curator --> DOC_ADD7
Curator --> DOC_ADD8
Curator --> DOC_ADD11
Curator --> DOC_READ1
Curator --> DOC_READ2
Curator --> DOC_EDIT1
Curator --> DOC_EDIT2
Curator --> DOC_EDIT3
Curator --> DOC_EDIT4
Curator --> DOC_EDIT5
Curator --> DOC_EDIT6
Curator --> DOC_EDIT7

DigitizationManager --> DOC_ADD5
DigitizationManager --> DOC_ADD9
DigitizationManager --> DOC_ADD10
DigitizationManager --> DOC_ADD11
DigitizationManager --> DIGI_MAN1
DigitizationManager --> DIGI_MAN2
DigitizationManager --> DIGI_MAN3
DigitizationManager --> DIGI_MAN4
DigitizationManager --> DOC_EDIT8

