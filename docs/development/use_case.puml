@startuml VERA - Use Case Diagram

' Draw settings
left to right direction

!define ALREADY_IMPLEMENTED_COLOR #A0E88E
!define REIMPLEMENT_COLOR #F1E27C
!define PLANNED_COLOR #87CEFA
!define MAYBE_IN_FUTURE_COLOR #F08080

skinparam usecase {
    BackgroundColor<< Already Implemented >> ALREADY_IMPLEMENTED_COLOR
    BackgroundColor<< Reimplement >> REIMPLEMENT_COLOR
    BackgroundColor<< Planned >> PLANNED_COLOR
    BackgroundColor<< Maybe In Future >> MAYBE_IN_FUTURE_COLOR
}

' Legend
legend top right
  | <ALREADY_IMPLEMENTED_COLOR> | Already Implemented |
  | <REIMPLEMENT_COLOR>         | Reimplement     |
  | <PLANNED_COLOR>             | Planned             |
  | <MAYBE_IN_FUTURE_COLOR>     | Maybe In Future     |
endlegend

' Documents

actor User
actor Curator
actor DocumentsManager

Curator <|-- DocumentsManager

package "Adding Documents" {
    usecase "Propose document for digitalization" as DOC1 <<Maybe In Future>>
    usecase "Cancel digitalization proposal" as DOC2 <<Maybe In Future>>
    usecase "Add document for digitalization" as DOC3 <<Already Implemented>>
    usecase "Select specific unit to add/propose" as DOC4 <<Already Implemented>>
    usecase "Browse processed added/proposed documents" as DOC5 <<Already Implemented>>
    usecase "Add already digitized document" as DOC6 <<Planned>>
    usecase "Add document again (if processed before)" as DOC7 <<Planned>>
}

package "Managing Digitization" {
    usecase "Decline digitization proposal" as DOC8 <<Maybe In Future>>
    usecase "Cancel the decline of document digitization proposal" as DOC9 <<Maybe In Future>>
    usecase "Decline digitization" as DOC10 <<Planned>>
    usecase "Cancel digitization decline" as DOC11 <<Planned>>
}

package "Reading Documents" {
    usecase "Search for documents (based on ownership permission)" as DOC12 <<Already Implemented>>
    usecase "View document details" as DOC13 <<Already Implemented>>
}

package "Editing Documents" {
    usecase "Update document category" as DOC14 <<Already Implemented>>
    usecase "Update extraction priority" as DOC15 <<Already Implemented>>
    usecase "Update manual page count" as DOC16 <<Already Implemented>>
    usecase "Run tasks on document" as DOC17 <<Already Implemented>>
    usecase "Archive document" as DOC18 <<Planned>>
    usecase "Remove document" as DOC19 <<Reimplement>>
}

User --> DOC1
User --> DOC2
User --> DOC4
User --> DOC5
User --> DOC12
User --> DOC13

Curator --> DOC3
Curator --> DOC4
Curator --> DOC5
Curator --> DOC12
Curator --> DOC13
Curator --> DOC14
Curator --> DOC15
Curator --> DOC16
Curator --> DOC17
Curator --> DOC18

DocumentsManager --> DOC6
DocumentsManager --> DOC7
DocumentsManager --> DOC8
DocumentsManager --> DOC9
DocumentsManager --> DOC10
DocumentsManager --> DOC11
DocumentsManager --> DOC19

' newpage

' Draw settings
left to right direction

skinparam usecase {
    BackgroundColor<< Already Implemented >> ALREADY_IMPLEMENTED_COLOR
    BackgroundColor<< Reimplement >> REIMPLEMENT_COLOR
    BackgroundColor<< Planned >> PLANNED_COLOR
    BackgroundColor<< Maybe In Future >> MAYBE_IN_FUTURE_COLOR
}

