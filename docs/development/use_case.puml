' Categories

actor CategoriesManager

Curator <|-- CategoriesManager

package "Category Operations" {
    usecase "Create/Update/Delete category" as CAT1 <<Reimplement>>
    usecase "Search categories" as CAT2 <<Reimplement>>
    usecase "Use categories while adding documents" as CAT3 <<Already Implemented>>
    usecase "Assign categories to user groups or to individual users" as CAT4 <<Planned>>
    usecase "Set automatic categories from data sources" as CAT5 <<Planned>>
    usecase "Manage category distributions" as CAT6 <<Reimplement>>
}

Curator -> CAT2
Curator -> CAT3

CategoriesManager --> CAT1
CategoriesManager --> CAT4
CategoriesManager --> CAT5
CategoriesManager --> CAT6

' Digitization Lists

actor DigitizationStaff
actor DigitizationManager

DigitizationStaff <|-- DigitizationManager

package "Digitization Lists" {
    usecase "Pregenerate digitization list (based on categories, locations, etc.)" as DL1 <<Reimplement>>
    usecase "Save pregeneration properties" as DL2 <<Planned>>
    usecase "List past pregeneration properties" as DL3 <<Planned>>
    usecase "Create digitalization list (from Documents view)" as DL4 <<Already Implemented>>
    usecase "Add/Remove items to digitalization list" as DL5 <<Already Implemented>>
    usecase "Remove digitalization list" as DL6 <<Already Implemented>>
}

DigitizationStaff --> DL1
DigitizationStaff --> DL3
DigitizationStaff --> DL4

DigitizationManager --> DL5
DigitizationManager --> DL6

System --> DL2

' Locations

package "Locations" {
    usecase "Create/Update/Delete locations" as LOC1 <<Reimplement>>
    usecase "List locations" as LOC2 <<Reimplement>>
    usecase "Create/Update/Delete location groups" as LOC3 <<Planned>>
    usecase "List locations by group" as LOC4 <<Planned>>
}

Curator --> LOC2
Curator --> LOC4

DigitizationStaff --> LOC2
DigitizationStaff --> LOC4

DigitizationManager --> LOC1
DigitizationManager --> LOC3

' Intentions

package "Intentions" {
    usecase "Create intentions based on time periods" as INT1 <<Planned>>
    usecase "Create project-based intentions" as INT2 <<Planned>>
    usecase "Update/Delete intentions" as INT3 <<Reimplement>>
    usecase "Assign intentions to extracted documents" as INT4 <<Planned>>
    usecase "Assign intentions to digitization lists" as INT5 <<Planned>>
    usecase "Search intentions" as INT6 <<Reimplement>>
    usecase "Create statistical views based on intentions" as INT7 <<Planned>>
}

CategoriesManager --> INT1
CategoriesManager --> INT2
CategoriesManager --> INT3

DigitizationManager --> INT4
DigitizationManager --> INT5

Curator --> INT6

System --> INT6

