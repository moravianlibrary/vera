' Categories

actor CategoriesManager

Curator <|-- CategoriesManager

package "Category Operations" {
    usecase "Create/Update/Delete category" as CAT1 <<Reimplement>>
    usecase "Search categories" as CAT2 <<Reimplement>>
    usecase "Use categories while adding documents" as CAT3 <<Already Implemented>>
    usecase "Assign categories to user groups or to individual users" as CAT4 <<Planned>>
    usecase "Assign bash(?) script to category to be used as documents source" as CAT5 <<Planned>>
    usecase "Manage category distributions" as CAT6 <<Reimplement>>
}

