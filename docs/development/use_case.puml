    usecase "Decline digitalization from specific record" as CR7 <<Planned>>
    usecase "Cancel declination of digitization" as CR8 <<Planned>>
    usecase "Reindex" as CR9 <<Already Implemented>>
    usecase "Reevaluate differences" as CR10 <<Already Implemented>>
    usecase "Synchronize with catalog" as CR11 <<Already Implemented>>
    usecase "Add record independently from documents" as CR12 <<Planned>>
}

package "Catalog Records Lists" {
    usecase "Manage catalog record lists" as CR13 <<Planned>>
    usecase "Assign lists to users" as CR14 <<Planned>>
    usecase "Notify users via email or in-app when list changes" as CR15 <<Planned>>
}

