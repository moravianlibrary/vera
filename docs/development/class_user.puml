@startuml VERA - User class diagram

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
skinparam linetype ortho
top to bottom direction

package "Digitization Planner" {

  package "Types" {
    enum Permission {

    }

    enum OwnershipScope {
      Own
      Group
      All
    }

    enum OwnershipPermission {

    }

    entity UserSettings extends JSON
  }

  package "Schemas" {

    entity MessageResponse {
      +status: StatusCode,
      +message: String
    }
  
    entity ItemMessageResponse<T> extends MessageResponse {
      +item: T | None
    }

    entity Permissions {
      +permissions: List<Permission>
      +ownershipPermissions: List<Tuple<OwnershipPermission, OwnershipScope>>
    }

    entity RoleEdit {
      +name: String
      +description: String | None
      +permissions: Permissions
    }

    entity Role extends RoleEdit {
      +id: Integer
    }

    entity GroupEdit {
      +name: String
      +description: String | None
      +users: List<String>
    }

    entity Group extends GroupEdit {
      +id: Integer
    }
  
    entity CurrentUser {
      +username: String
      +settings: UserSettings
      +role: Role
      +groups: List<Group>
    }

    entity UserNotifications {
      +taskChanges: List<Task>
      +enqueuedDocumentAdditions: Integer
      +processedDocumentAdditions: Integer
      +catalogRecordListsChanged: List<CatalogRecordList>
    }

    entity KeycloakSettings {
      +serverUrl: String
      +realmName: String
      +clientId: String
      +clientSecret: String
      +issuerClientId: String
      +usernameField: String | None
      +roleNamesField: String | None
    }

    Permissions --> Permission : contains
    Permissions --> OwnershipPermission : contains
    Permissions --> OwnershipScope : contains

    RoleEdit --> Permissions : has

    CurrentUser --> Role : has
    CurrentUser --> Group : belongs to
    CurrentUser --> UserSettings : has
  }
  
  package "Repositories" {
  
    package "Model" {

      class RoleModel {
        +id: Integer
        +name: String
        +description: String | None
      }

      class GroupModel {
        +id: Integer
        +name: String
        +description: String | None
        +users(): List<UserModel>
      }

      class UserModel {
        +username: String
        +settings: JSON
        +notificationsLastChecked: Timestamp
        +groups(): List<GroupModel>
      }

      class UserGroupRelationship {
        +username: String
        +group_id: Integer
      }
    }

    class RoleRepository {
      +get(roleId: Integer): RoleModel
      +find(roleName: String): RoleModel
      +save(role: RoleModel): RoleModel
      +delete(roleId: Integer): RoleModel
      +getAll(): List<RoleModel>
    }

    class GroupRepository {
      +get(groupId: Integer): GroupModel
      +save(group: GroupModel): GroupModel
      +delete(groupId: Integer): GroupModel
      +getAll(): List<GroupModel>
    }

    class UserRepository {
      +get(username: String): UserModel
      +save(user: UserModel): UserModel
    }

    RoleRepository --> RoleModel : manages
    GroupRepository --> GroupModel : manages
    GroupRepository --> UserGroupRelationship : manages
    UserRepository --> UserModel : manages

    RoleModel --> Role : maps to
    GroupModel --> Group : maps to

    class DocumentAdditionRepository
    class TaskRepository
    class CatalogRecordRepository
  }
  
  package "Services" {

    class UserService {
      +getCurrentUser(token: String): CurrentUser
      +getNotifications(username: String): UserNotifications
    }

    interface AuthService {
      +getUserInfo(token: String): Map<String, Object>
      +parseUsername(userInfo: Map<String, Object>): String
      +parseRoleNames(userInfo: Map<String, Object>): List<String>
    }

    class KeycloakService implements AuthService {
      +KeycloakService(settings: KeycloakSettings)
    }

    KeycloakService --> KeycloakSettings : uses

    UserService --> AuthService : calls
    UserService --> UserRepository : calls
    UserService --> DocumentAdditionRepository : get additions changes
    UserService --> TaskRepository : get tasks changes
    UserService --> CatalogRecordRepository : get catalog records lists changes

    UserService --> CurrentUser : creates
    UserService --> UserNotifications : creates
  }

  package "Security" {
    class AccessControlEnforcer {
      +AccessControlEnforcer(permission: Permission, token: String)
    }

    class OwnershipAccessControl {
      +AccessControlEnforcer(permission: OwnershipPermission, token: String)
    }
  }
  
  package "API Controllers" {

    class RoleController {
      +getAll(): List<Role>
      +create(role: RoleEdit): ItemMessageResponse<Role>
      +update(roleId: Integer, role: RoleEdit): ItemMessageResponse<Role>
      +delete(roleId: Integer): MessageResponse
    }

    RoleController --> RoleRepository : calls

    class GroupController {
      +getAll(): List<Group>
      +create(group: GroupEdit): ItemMessageResponse<Group>
      +update(groupId: Integer, group: GroupEdit): ItemMessageResponse<Group>
      +delete(groupId: Integer): MessageResponse
    }

    GroupController --> GroupRepository : calls

    class UserController {
      +getCurrentUser(): CurrentUser
      +getNotifications(): UserNotifications
      +getSettings(): UserSettings
      +saveSettings(settings: UserSettings): MessageResponse
    }

    UserController --> UserService : calls
    UserController --> UserRepository : calls
  }
}

@enduml
