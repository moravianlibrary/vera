@startuml VERA - Class Diagram - All Types

package "Digitization Planner" {

  package "Types" {

    enum IdentifierType {
      Barcode
      SystemNumber
      ISXN
      Signature
    }

    enum DocumentProposalStatus {
      Enqueued
      Processing
      NotEligibleForAddition
      Pending
      Accepted
      Declined
    }

    enum DocumentAdditionStatus {
      Enqueued
      Processing
      NotEligibleForAddition
      Completed
    }

    enum DocumentEligibilityStatus {
      Ready
      ActiveDuplicate
      FullyProcessedDuplicate
      InDigitization
      DigitizationForbidden
      AmbiguousIssues
      AllIssuesResolved
      CatalogRecordFailure
      DigitizationRegistryFailure
      InternalFailure
    }

    enum IntentionStatus {
      Direct
      Proposed
      Accepted
      Declined
    }

    enum DocumentTask {
      UpdateProperty
      Remove
      DeclineDigitization
      CancelDigitizationDeclination
      GenerateDigitizationList
      Reindex
      SyncDigitizationState
      SyncCatalogRecord
      PredictPageCount
    }

    enum CatalogRecordTask {
      IgnoreMissingAuthority
      Reindex
      Sync
      ReevaluateDifferences
    }

    ' Max 1 running at a time
    ' Max 1 planned at a time
    enum CategoryTask {
      Reindex
      ReindexAll
      ' Can be planned
      ExecuteScript
    }

    ' Max 1 running at a time
    ' Max 1 planned at a time
    enum SystemTask {
      ' Can be planned
      RecreateIndex
      ' Can be planned
      ResolveInconsistencies
      ' Can be planned
      GenerateBackup
      LoadFromBackup
    }

    enum Permission {
      SearchThroughCatalog
      ProposeDocuments
      AddDocuments
      ReviewDocumentProposals
      DeclineDigitization
    }

    enum OwnershipScope {
      Own
      Group
      All
    }

    enum OwnershipPermission {
      ReadDocuments
      EditDocuments
      ReadCategories
      EditCategories
    }
  }
}

@enduml
