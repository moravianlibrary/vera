@startuml VERA - Class Diagram - Catalog Adapter

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 20
skinparam linetype ortho
top to bottom direction

package "Adapters" {

  package "Catalog" {

    enum CatalogFetchStatus {
      CatalogUnavailable
      CatalogRequestFailed
      RecordNotFound
      UnrecognizedBase
      InvalidSystemNumber
      Success
    }

    entity CatalogGetResponse {
      record: Record | None
      status: CatalogFetchStatus
    }

    entity CatalogSearchItem {
      base: String
      systemNumber: String
      record: Record
    }

    entity CatalogSearchResponse {
      items: List<CatalogSearchItem> | None
      numFound: Integer
      status: CatalogFetchStatus
    }

    entity CatalogSearchParams {
      +value: String
      +base: String | None
      +field: String | None
      +page: Integer
      +pageSize: Integer
    }

    entity AlephCatalogAdapterConfig {
      base: String
    }

    entity CatalogAdapterConfig {
    }

    interface CatalogAdapterInterface {
      +getRecord(base: String, systemNumber: String): CatalogGetResponse
      +search(params: CatalogSearchParams): CatalogSearchResponse
    }

    CatalogAdapterInterface --> CatalogSearchParams : uses

    class AlephCatalogAdapter implements CatalogAdapterInterface {
      +loadConfig(config: AlephCatalogAdapterConfig): None
    }

    class AlephZ3950 
    class AlephXApi 
    class AlephOaiApi

    class CatalogAdapter implements CatalogAdapterInterface {
      +loadConfig(config: CatalogAdapterConfig): None
      +findMatchingAuthorityRecord(record: Record, authorityBase: String): CatalogSearchResponse
    }

    CatalogGetResponse --> CatalogFetchStatus : uses
    CatalogSearchResponse --> CatalogFetchStatus : uses
    CatalogSearchResponse o-- CatalogSearchItem : contains

    CatalogAdapterInterface o-- CatalogGetResponse : returns >
    CatalogAdapterInterface o-- CatalogSearchResponse : returns >

    AlephCatalogAdapter ..> AlephZ3950 : calls >
    AlephCatalogAdapter ..> AlephXApi : calls >
    AlephCatalogAdapter ..> AlephOaiApi : calls >

    CatalogAdapter o-- AlephCatalogAdapter : manages >
  }
}
