@startuml VERA - Class Diagram - Catalog Adapter

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 10
skinparam linetype ortho
top to bottom direction

package "Adapters" {

  package "Catalog" {
    enum CatalogFetchStatus {
      CatalogUnavailable
      CatalogRequestFailed
      RecordNotFound
      UnrecognizedBase
      InvalidSystemNumber
      Success
    }

    entity CatalogGetResponse {
      record: Record | None
      status: CatalogFetchStatus
    }

    entity CatalogSearchItem {
      base: String
      systemNumber: String
      record: Record
    }

    entity CatalogSearchResponse {
      items: List<CatalogSearchItem> | None
      numFound: Integer
      status: CatalogFetchStatus
    }

    interface CatalogConnector {
      +getRecord(base: String, systemNumber: String): CatalogGetResponse
      +search(
        value: String,
        base: String | None,
        field: String | None,
        page: Integer,
        pageSize: Integer
      ): CatalogSearchResponse
    }

    class AlephCatalogConnector extends CatalogConnector {
      +loadConfig(config: AlephCatalogConnectorConfig): None
    }

    class AlephZ3950 {
    }

    class AlephXApi {
    }

    class AlephOaiApi {
    }

    class CatalogConnectorManager extends CatalogConnector {
      +loadConfig(config: CatalogConnectorConfig): None
      +findAuthoritySystemNumber(base: String, systemNumber: String, authorityBase: String): CatalogGetResponse
    }

    CatalogGetResponse --> CatalogFetchStatus : uses >
    CatalogSearchResponse --> CatalogFetchStatus : uses >
    CatalogSearchResponse o-- CatalogSearchItem : contains >

    CatalogConnector o-- CatalogGetResponse : returns >
    CatalogConnector o-- CatalogSearchResponse : returns >

    AlephCatalogConnector --> AlephZ3950 : uses
    AlephCatalogConnector --> AlephXApi : uses
    AlephCatalogConnector --> AlephOaiApi : uses

    CatalogConnectorManager *-- CatalogConnector : manages >
  }

  package "Digitization Registry" {
    enum DRFetchStatus {
      Unavailable
      RequestFailed
      Success
    }

    enum DRState {
      Finished
      InProgress
      Planned
      NotDigitized
      Revision
      Unknown
    }

    entity DRConnectorResponse {
      source: String | None
      id: String | None
      state: DRState | None
      status: DRFetchStatus
    }

    interface DRConnector {
      +getRecord(recordId: String): DRConnectorResponse
      +search(record: Record, issue: Issue): DRConnectorResponse
    }

    class RDczConnector implements DRConnector
    class DRKrameriusConnector implements DRConnector

    class DRDispatcher {
      +loadConfig(config: DRConnectorConfig): None
      +getRecord(recordId: String): List<DRConnectorResponse>
      +search(record: Record, issue: Issue): List<DRConnectorResponse>
    }

    DRConnectorResponse --> DRFetchStatus : uses >
    DRConnectorResponse --> DRState : uses >

    DRDispatcher o-- DRConnectorResponse : returns >
    DRConnector o-- DRConnectorResponse : returns >
    DRDispatcher *-- DRConnector : manages >
  }
}
