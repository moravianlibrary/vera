@startuml VERA - Class Diagram - Catalog Adapter

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 10
skinparam linetype ortho
top to bottom direction

package "Adapters" {

  package "Digitization Registry" {
    enum DRFetchStatus {
      Unavailable
      RequestFailed
      Success
    }

    enum DRState {
      Finished
      InProgress
      Planned
      NotDigitized
      Revision
      Unknown
    }

    entity DRAdapterResponse {
      source: String
      id: String | None
      recordState: DRState | None
      issueState: DRState | None
      status: DRFetchStatus
    }

    entity RDczConfig
    entity KrameriusConfig
    entity Record
    entity Issue

    DRAdapterResponse --> DRFetchStatus : uses >
    DRAdapterResponse --> DRState : uses >

    interface DRAdapterInterface {
      +getRecord(recordId: String): DRAdapterResponse
      +search(record: Record, issue: Issue): DRAdapterResponse
    }

    DRAdapterInterface o-- DRAdapterResponse : returns >
    DRAdapterInterface o-- DRAdapterResponse : returns >

    class RDczAdapter implements DRAdapterInterface {
      +RDczAdapter(config: RDczConfig)
    }

    RDczAdapter --> RDczConfig : uses

    class DRKrameriusAdapter implements DRAdapterInterface {
      +DRKrameriusAdapter(config: KrameriusConfig)
    }

    DRKrameriusAdapter --> KrameriusConfig : uses

    class DRAdapter {
      +loadConfig(config: DRAdapterConfig): None
      +getRecord(recordId: String): List<DRAdapterResponse>
      +search(record: Record, issue: Issue): List<DRAdapterResponse>
    }

    DRAdapter *-- RDczAdapter : manages >
    DRAdapter *-- DRKrameriusAdapter : manages >
  }
}
