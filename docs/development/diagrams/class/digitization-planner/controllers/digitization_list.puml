@startuml VERA - Class Diagram - Digitization List Controller

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Schemas" {

    entity DigitizationListIntention {
      +id: Integer
      +name: String
    }

    entity DigitizationList {
      +id: Integer
      +createdBy: String
      +createdAt: Timestamp
      +isArchived: Boolean
      +countTotalPages: Integer
      +intentions: DigitizationListIntention
    }

    DigitizationList o-- DigitizationListIntention : contains

    entity DigitizationListQuery
    entity DigitizationListResponse
    DigitizationListResponse --> DigitizationList : contains

    class DocumentQuery
    class Task

    entity ItemMessageResponse
  }

  package "Repositories" {

    package "Model" {

      class DocumentIterationModel
      class IntentionModel

      class DigitizationListModel {
        +id: Integer
        +createdBy: String
        +createdAt: Timestamp = Timestamp::Now
        +isArchived: Boolean = False
        +documents(): List<DocumentIterationModel>
        +intentions(): List<IntentionModel>
      }

      class DigitizationListIntentionModel {
        +digitizationListId: Integer
        +intentionId: Integer
      }

      DigitizationListModel *-- DocumentIterationModel : returns >
      DigitizationListModel *-- IntentionModel : returns >

      DigitizationListModel -- DigitizationListIntentionModel : "links intentions"
    }

    class DigitizationListRepository {
      +get(digitizationListId: Integer): DigitizationListModel
      +listAll(): List<DigitizationListModel>
      +save(digitizationList: DigitizationListModel): DigitizationListModel
      +delete(digitizationListId: Integer): DigitizationListModel
      +index(digitizationList: DigitizationListModel): DigitizationListModel
      +search(query: DigitizationListQuery): DigitizationListResponse
    }

    DigitizationListRepository --> DigitizationListQuery : uses

    DigitizationListRepository --> DigitizationListModel : manages >
    DigitizationListRepository --> DigitizationListResponse : returns >

    class DocumentRepository
  }

  package "Services" {

    entity AddDocumentsResponse {
      +countAdded: Integer
      +countAlreadyPresent: Integer
      +countFailed: Integer
    }

    entity RemoveDocumentsResponse {
      +countRemoved: Integer
      +countNotPresent: Integer
      +countFailed: Integer
    }

    class DigitizationListService {
      +addDocuments(digitizationListId: Integer, query: DocumentQuery): AddDocumentsResponse
      +removeDocuments(digitizationListId: Integer, query: DocumentQuery): RemoveDocumentsResponse
    }

    DigitizationListService o-- AddDocumentsResponse : returns >
    DigitizationListService o-- RemoveDocumentsResponse : returns >

    DigitizationListService ..> DigitizationListRepository : calls >
    DigitizationListService ..> DocumentRepository : calls >
    DigitizationListService ..> DigitizationListTaskService : schedule documents reindex >

    class TaskService
  }

  package "API Controllers" {

    class DigitizationListController {
      +create(query: DocumentQuery): ItemMessageResponse<Task>
      +archive(digitizationListId: Integer): ItemMessageResponse<Task>
      +delete(digitizationListId: Integer): ItemMessageResponse<Task>
      +addDocuments(digitizationListId: Integer, query: DocumentQuery): ItemMessageResponse<Task>
      +removeDocuments(digitizationListId: Integer, query: DocumentQuery): ItemMessageResponse<Task>
      +search(query: DigitizationListQuery): DigitizationListResponse
    }

    DigitizationListController --> DocumentQuery : uses
    DigitizationListController --> DigitizationListQuery : uses

    DigitizationListController --> ItemMessageResponse : returns >
    DigitizationListController --> Task : returns >
    DigitizationListController --> DigitizationListResponse : returns >

    DigitizationListController ..> TaskService : schedule tasks >
    DigitizationListController ..> DigitizationListService : calls >
    DigitizationListController ..> DigitizationListRepository : calls >
  }
}

@enduml
