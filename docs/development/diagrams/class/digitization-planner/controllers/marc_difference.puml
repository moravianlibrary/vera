@startuml VERA - Class Diagram - Catalog Record Controller

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Types" {

    enum DifferenceFixStatus {
      PendingFix
      Fixed
    }

    enum DifferenceApprovalStatus {
      Approved
      ApprovalRevoked
    }

    enum DifferenceStatus extends DifferenceFixStatus, DifferenceApprovalStatus {
      Undecided
    }

    enum DifferenceType
    enum DifferenceCategory
  }

  package "Schemas" {

    entity MarcDifference {
      +type: DifferenceType
      +category: DifferenceCategory
      +field: String
      +subfield: String | None
      +currentStatus: DifferenceStatus
    }

    MarcDifference --> DifferenceType : contains
    MarcDifference --> DifferenceCategory : contains
    MarcDifference --> DifferenceStatus : contains

    entity MarcDifferenceStatusLog {
      +status: DifferenceStatus
      +changedBy: String
      +changedAt: Timestamp
    }

    MarcDifferenceStatusLog --> DifferenceStatus : contains

    entity MarcDifferenceDetails extends MarcDifference {
      +indicator1: String | None
      +indicator2: String | None
      +value: String | None
      +statusLog: List<MarcDifferenceStatusLog>
      ' Also others configurable attributes
    }

    MarcDifferenceDetails --> MarcDifferenceStatusLog : contains

    entity MessageResponse
    entity ItemMessageResponse
    entity PrimaryRecord
    entity Task
  }

  package "Repositories" {

    package "Model" {

      class MarcDifferenceModel {
        +id: Integer
        +mainId: String
        +authorityId: String
        +field: String
        +type: DifferenceType
        +category: DifferenceCategory
        +subfield: String | None = None
        +indicator1: String | None = None
        +indicator2: String | None = None
        +value: String | None = None
        +fixStatus: DifferenceFixStatus | None = None
        +approvalStatus: DifferenceApprovalStatus | None = None
        +statusLog(): List<DifferenceStatusLogModel>
        +currentStatus(): List<DifferenceStatus>
      }

      MarcDifferenceModel --> DifferenceType : contains
      MarcDifferenceModel --> DifferenceCategory: contains
      MarcDifferenceModel --> DifferenceFixStatus : contains
      MarcDifferenceModel --> DifferenceApprovalStatus : contains

      MarcDifferenceModel --> DifferenceStatusLogModel : returns >
      MarcDifferenceModel --> DifferenceStatus : returns >

      class DifferenceStatusLogModel {
        +id: Integer
        +status: DifferenceStatus
        +changedBy: String
        +changedAt: Timestamp
      }

      DifferenceStatusLogModel --> DifferenceStatus : contains
    }

    class MarcDifferenceRepository {
      +getById(differenceId: Integer): MarcDifferenceModel
      +save(difference: MarcDifferenceModel): MarcDifferenceModel
    }

    MarcDifferenceRepository --> MarcDifferenceModel : manages >
    MarcDifferenceRepository --> DifferenceStatusLogModel : manages >
  }

  package "Adapters" {
    class MarcComparatorConnector
  }

  package "Services" {

    class MarcDifferenceService {
      +syncRecordDifferences(authorityRecord: AuthorityRecordModel): AuthorityRecordModel
    }

    MarcDifferenceService ..>  MarcDifferenceRepository : calls >
    MarcDifferenceService ..>  MarcComparatorConnector : calls >
  }

  package "API Controllers" {

    class MarcDifferenceController {
      +setPendingFix(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
      +unsetPendingFix(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
      +approveDifference(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
      +revokeDifferenceApproval(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
    }

    MarcDifferenceController --> ItemMessageResponse : returns >
    MarcDifferenceController --> PrimaryRecord : returns >
    MarcDifferenceController --> Task : returns >

    MarcDifferenceController ..> MarcDifferenceRepository : calls >
  }
}

@enduml
