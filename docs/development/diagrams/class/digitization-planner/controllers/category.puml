@startuml VERA - Class Diagram - Category Controller

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {
    
  package "Schemas" {

    entity CategoryEdit {
      +name: String
      +descripton: String | None
      +assignable: Boolean
      +disabled: Boolean
    }

    entity CategoryGroup {
      +id: Integer
      +name: String
    }

    entity CategoryDistribution {
      +distributionId: Integer
      +percentage: Float
    }

    entity Category extends CategoryEdit {
      +id: Integer
      +intentionId: Integer | None
      +parentId: Integer | None
      +level: Integer
      +archived: Boolean
      +assignedToGroups: List<CategoryGroup>
      +assignedToUsers: List<String>
      +assignedIndirectlyToGroups: List<CategoryGroup>
      +assignedIndirectlyToUsers: List<String>
      +hasScript: Boolean
      +hasRecurringTask: Boolean
      +distributions: List<CategoryDistribution>
      +countTotalPages: Integer
      +countTotalDocuments: Integer
      +countExtractablePages: Integer
      +countExtractableDocuments: Integer
      +countExtractedPages: Integer
      +countExtractedDocuments: Integer
    }

    Category --> CategoryGroup : uses
    Category --> CategoryDistribution : uses

    entity CategoryQuery
    entity CategoryResponse
    CategoryResponse --> Category : contains

    entity MessageResponse
    entity ItemMessageResponse
  }

  package "Repositories" {

    package "Model" {

      class CategoryModel {
        +id: Integer
        +name: String
        +descripton: String | None
        +intentionId: Integer | None = None
        +parentId: Integer | None = None
        +level: Integer = 0
        +assignable: Boolean = False
        +extractWhole: Boolean = False
        +disabled: Boolean = False
        +archived: Boolean = False
        +assignedToGroups(): List<GroupModel>
        +assignedToUsers(): List<UserModel>
        +assignedIndirectlyToGroups(): List<GroupModel>
        +assignedIndirectlyToUsers(): List<UserModel>
        +hasScript(): Boolean
        +hasRecurringTask(): Boolean
        +totalPageCount(): Integer
        +totalDocuments(): Integer
        +extractablePageCount(): Integer
        +extractableDocuments(): Integer
        +extractedPageCount(): Integer
        +extractedDocuments(): Integer
      }

      class CategoryGroupModel {
        +categoryId: Integer
        +groupId: Integer
      }

      class CategoryUserModel {
        +categoryId: Integer
        +username: String
      }
      class GroupModel
      class UserModel

      CategoryModel *-- UserModel : assignedToUsers
      CategoryModel *-- GroupModel : assignedToGroups

      CategoryModel -- CatalogRecordListUserModel : "links users"
      CategoryModel -- CatalogRecordListGroupModel : "links groups"
    }

    class CategoryRepository {
      +getById(categoryId: Integer): CategoryModel
      +listAll(): List<CategoryModel>
      +save(category: CategoryModel): CategoryModel
      +index(category: CategoryModel): CategoryModel
      +search(query: CategoryQuery): CategoryResponse
      +delete(categoryId: Integer): CategoryModel
    }

    CategoryRepository --> CategoryQuery : uses

    CategoryRepository --> CategoryModel : manages >
    CategoryRepository --> CategoryUserModel : manages >
    CategoryRepository --> CategoryGroupModel : manages >

    CategoryRepository --> CategoryResponse : returns >

    class DistributionRepository
    class IntentionRepository
  }

  package "Services" {

    class CategoryService {
      +create(parentId: Integer | None, category: CategoryEdit): CategoryModel
      +createProjectCategory(projectId: Integer, category: CategoryEdit): CategoryModel
      +changeDistribution(categoryId: Integer, distributionId: Integer, distribution: List<CategoryDistributionEdit>): None
      +changeParent(categoryId: Integer, fromParent: Integer | None, toParent: Integer | None): None
      +restrictQuery(query: CategoryQuery, user: CurrentUser): CategoryQuery
    }

    CategoryService --> CategoryEdit : uses
    CategoryService --> CategoryDistributionEdit : uses
    CategoryService --> CategoryQuery : uses
    CategoryService --> CurrentUser : uses

    CategoryService --> CategoryModel : returns >

    CategoryService ..> CategoryRepository : calls >
    CategoryService ..> DistributionRepository : calls >
    CategoryService ..> IntentionRepository : calls >
  }

  package "API Controllers" {    

    class CategoryController {
      +search(query: CategoryQuery): CategoryResponse
      +create(parentId: Integer | None, category: CategoryEdit): MessageResponse
      +createProjectCategory(projectId: Integer, category: CategoryEdit): MessageResponse
      +update(categoryId: Integer, category: CategoryEdit): ItemMessageResponse<Category>
      +changeParent(categoryId: Integer, fromParent: Integer | None, toParent: Integer | None): MessageResponse
      +changeDistribution(categoryId: Integer, distributionId: Integer, distribution: List<CategoryDistributionEdit>): MessageResponse
      +archive(categoryId: Integer): MessageResponse
      +delete(categoryId: Integer): MessageResponse
    }

    CategoryController --> CategoryEdit : uses
    CategoryController --> CategoryDistributionEdit : uses
    CategoryController --> CategoryQuery : uses

    CategoryController --> Category : returns >
    CategoryController --> MessageResponse : returns >
    CategoryController --> ItemMessageResponse : returns >
    CategoryController --> CategoryResponse : returns >

    CategoryController ..> CategoryService : calls >
    CategoryController ..> CategoryRepository : calls >
  }
}

@enduml
