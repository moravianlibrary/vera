@startuml VERA - Class Diagram - Documents

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Types" {

    enum DocumentStatus {
      IsExtractable
      IsNotExtractable
      SyncFailed
    }

    enum DocumentIterationStatus extends DocumentStatus {
      AlreadyExtracted
    }

  }

  package "Schemas" {

    entity DocumentCategory {
      +id: Integer
      +name: String
    }

    entity Document {
      +id: Integer
      +base: String
      +systemNumber: String
      +barcode: String | None
      +volumeNumber: String | None
      +volumeYear: String | None
      +bundle: String | None
      +issuanceType: IssuanceType
      +pageCount: Dict<String, Integer>
      +iteration: Integer
      +addedAt: Timestamp = Timestamp::Now
      +addedBy: String
      +categoryId: Integer
      +priority: Integer [1-5]
      +digitizationListId: Integer | None
      +categoryPath: List<DocumentCategory>
      +extractedBy: String | None
      +extractedAt: String | None
      +status: DocumentIterationStatus
      +isArchived: Boolean
    }

    Document --> DocumentCategory : contains
    Document --> DocumentIterationStatus : contains

    entity GenerateDocumentListSettings {
      +targetPageCount: Integer | None
      +targetPageCountThreshold: Float | None
      +useCategoryDistributions: Boolean | None
      +wholeCategoryThreshold: Float | None
    }

    entity DocumentQuery
    entity DocumentResponse
    DocumentResponse --> Document : contains

    entity CurrentUser {
      +username: String
      +settings: UserSettings
      +role: Role
      +groups: List<Group>
    }
    
    entity Task
  }

  package "Repositories" {

    package "Model" {

      class CatalogRecordModel

      class DocumentModel {
        +id: Integer
        +base: String
        +systemNumber: String
        +barcode: String | None
        +volumeNumber: String | None
        +volumeYear: String | None
        +bundle: String | None
        +issuanceType: IssuanceType
        +pageCount: Dict<String, Integer>
        +catalogRecord(): CatalogRecordModel
        +getPageCount(): Integer | None
        +status(): DocumentStatus
      }
      
      DocumentModel --> CatalogRecordModel : returns >
      DocumentModel --> DocumentStatus : returns >

      class CategoryModel

      class DocumentIterationModel {
        +id: Integer
        +documentId: Integer
        +iteration: Integer
        +addedAt: Timestamp = Timestamp::Now
        +addedBy: String
        +categoryId: Integer
        +priority: Integer [1-5] = 3
        +digitizationListId: Integer | None = None
        +document(): DocumentModel
        +category(): CategoryModel
        +isExtractable(): Boolean
        +extractedBy(): String | None
        +extractedAt(): String | None
        +status(): DocumentIterationStatus
        +isArchived(): Boolean
      }

      DocumentIterationModel --> DocumentModel : returns >
      DocumentIterationModel --> CategoryModel : returns >
      DocumentIterationModel --> DocumentIterationStatus : returns >
    }

    entity FindDocumentRequest {
      +base: String
      +systemNumber: String
      +barcode: String | None
      +volumeNumber: String | None
      +volumeYear: String | None
      +bundle: String | None
    }

    class DocumentRepository {
      +find(request: FindDocumentRequest): DocumentModel | None
      +save(document: DocumentModel): DocumentModel
      +delete(documentId: Integer): DocumentModel
    }

    DocumentRepository --> FindDocumentRequest : uses
    DocumentRepository --> DocumentModel : manages >

    class DocumentIterationRepository {
      +get(documentId: Integer, iteration: Integer): DocumentIterationModel
      +listAll(): List<DocumentIterationModel>
      +save(document: DocumentIterationModel): DocumentIterationModel
      +delete(documentId: Integer, iteration: Integer): DocumentIterationModel
      +index(document: DocumentIterationModel): DocumentIterationModel
      +search(query: DocumentQuery): DocumentResponse
    }

    DocumentIterationRepository --> DocumentModel : reads >
    DocumentIterationRepository --> DocumentIterationModel : manages >
  }

  package "Services" {

    class DocumentService {
      +restrictQuery(query: DocumentQuery, user: CurrentUser): DocumentQuery
      +generateExport(query: DocumentQuery): pd.Dataframe
      +planUpdatePropertyTask(query: DocumentQuery, propertyName: String, propertyValue: String): Task
      +planGenerateListTask(query: DocumentQuery, settings: GenerateDocumentListSettings): Task
    }

    DocumentService --> DocumentQuery : uses
    DocumentService --> CurrentUser : uses
    
    DocumentService --> Task : returns >

    DocumentService --> DocumentRepository : calls >
    DocumentService --> TaskService : plan tasks >

    class TaskService
  }

  package "API Controllers" {
    
    class DocumentController {
      +search(query: DocumentQuery): DocumentResponse
      +export(query: DocumentQuery): CsvFile | TxtFile
      +updateProperty(query: DocumentQuery, propertyName: String, propertyValue: String): Task
      +generateList(query: DocumentQuery, settings: GenerateDocumentListSettings): Task
      +getPrevGenerateListSetting(): List<GenerateDocumentListSettings>
    }

    DocumentController --> DocumentQuery : uses
    DocumentController --> GenerateDocumentListSettings : uses

    DocumentController --> DocumentResponse : returns >
    DocumentController --> Task : returns >

    DocumentController --> DocumentRepository : calls >
    DocumentController --> DocumentService : calls >
  }
}

@enduml