@startuml VERA - Class Diagram - Catalog Record Controllers

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Types" {

    enum CatalogRecordStatus {
      Valid
      Invalid
      Unreachable
      Synced
      Archived
      Revived
    }
    
    enum DifferenceStatus {
      Undecided
      PendingFix
      Fixed
      Approved
      ApprovalRevoked
    }

    enum DifferenceType
    enum DifferenceCategory
  }

  package "Schemas" {

    entity AuthorityRecordBase {
      +authorityBase: String
      +authorityId: String | None = None
      +status: List<CatalogRecordStatus>
    }

    AuthorityRecordBase --> CatalogRecordStatus : contains

    entity PrimaryRecordBase {
      +id: String
      +base: String
      +systemNumber: String
      +status: List<CatalogRecordStatus>
      +addedAt: Timestamp
      +updatedAt: Timestamp
      +hasAddedDocuments: Boolean
      +hasActiveDocuments: Boolean
      ' Also others configurable attributes
    }

    PrimaryRecordBase --> CatalogRecordStatus : contains

    entity MarcDifference {
      +type: DifferenceType
      +category: DifferenceCategory
      +field: String
      +subfield: String | None
      +currentStatus: DifferenceStatus
    }

    MarcDifference --> DifferenceType : contains
    MarcDifference --> DifferenceCategory : contains
    MarcDifference --> DifferenceStatus : contains

    entity AuthorityRecord extends AuthorityRecordBase {
      +differences: List<MarcDifference>
    }

    AuthorityRecord --> MarcDifference : contains

    entity PrimaryRecord extends PrimaryRecordBase {
      +authorityRecords: List<AuthorityRecord>
    }

    PrimaryRecord --> AuthorityRecord : contains

    entity MarcDifferenceStatusLog {
      +status: DifferenceStatus
      +changedBy: String
      +changedAt: Timestamp
    }

    MarcDifferenceStatusLog --> DifferenceStatus : contains

    entity MarcDifferenceDetails extends MarcDifference {
      +indicator1: String | None
      +indicator2: String | None
      +value: String | None
      +statusLog: List<MarcDifferenceStatusLog>
      ' Also others configurable attributes
    }

    MarcDifferenceDetails --> MarcDifferenceStatusLog : contains

    entity CatalogRecordStatusLog {
      +status: CatalogRecordStatus
      +changedAt: Timestamp
    }

    CatalogRecordStatusLog --> CatalogRecordStatus : contains

    entity AuthorityRecordDetails extends AuthorityRecordBase {
      +marc: MarcRecord
      +differences: List<MarcDifferenceDetails>
      +statusLog: List<CatalogRecordStatusLog>
    }

    AuthorityRecordDetails --> MarcDifferenceDetails : contains
    AuthorityRecordDetails --> CatalogRecordStatusLog : contains

    entity PrimaryRecordDetails extends PrimaryRecord {
      +marc: MarcRecord
      +statusLog: List<CatalogRecordStatusLog>
    }

    PrimaryRecordDetails --> CatalogRecordStatusLog : contains

    entity CatalogRecordQuery
    entity CatalogRecordResponse
    CatalogRecordResponse --> PrimaryRecord : contains

    entity CatalogRecordListGroup {
      +id: Integer
      +name: String
    }

    entity CatalogRecordListEdit {
      +name: String
      +description: String | None
      +query: CatalogRecordQuery
      +assignedToGroups: List<CatalogRecordListGroup>
      +assignedToUsers: List<String>
    }

    CatalogRecordListEdit o-- CatalogRecordListGroup : contains 

    entity CatalogRecordList extends CatalogRecordListEdit {
      +id: Integer
      +createdBy: String
      +hasUndecidedDifferences: Boolean | None
    }

    entity MessageResponse
    entity ItemMessageResponse
    entity Task
  }

  package "Repositories" {

    package "Model" {

      class CatalogRecordModel {
        +id: String
        +base: String
        +systemNumber: String
        +marc: MarcRecord
        +isUnreachable: Boolean
        +isArchived: Boolean = False
        +isValid: Boolean | None = None
        +statusLog(): List<CatalogRecordStatusLogModel>
      }

      CatalogRecordModel --> CatalogRecordStatusLogModel : contains

      class CatalogRecordStatusLogModel {
        +id: String
        +status: CatalogRecordStatus
        +changedAt: Timestamp
      }

      CatalogRecordStatusLogModel --> CatalogRecordStatus : contains

      class PrimaryRecordModel {
        +id: String
        +addedAt: Timestamp
        +updatedAt: Timestamp
        +hasAddedDocuments(): Boolean
        +hasActiveDocuments(): Boolean
        +catalogRecord(): CatalogRecordModel
        +authorityRecords(): List<AuthorityRecordModel>
      }

      PrimaryRecordModel --> CatalogRecordModel : returns >
      PrimaryRecordModel --> AuthorityRecordModel : returns >

      class AuthorityRecordModel {
        +mainId: String
        +authorityBase: String
        +authorityId: String | None = None
        +authorityRecord(): CatalogRecordModel | None
        +differences(): List<MarcDifferenceModel> | None
      }

      AuthorityRecordModel --> CatalogRecordModel : returns >
      AuthorityRecordModel --> MarcDifferenceModel : returns >

      class MarcDifferenceModel {
        +id: Integer
        +mainId: String
        +authorityId: String
        +field: String
        +type: DifferenceType
        +category: DifferenceCategory
        +subfield: String | None = None
        +indicator1: String | None = None
        +indicator2: String | None = None
        +value: String | None = None
        +pendingFix: Boolean = False
        +approved: Boolean = False
        +statusLog(): List<DifferenceStatusLogModel>
        +currentStatus(): List<DifferenceStatus>
      }

      MarcDifferenceModel --> DifferenceType : contains
      MarcDifferenceModel --> DifferenceCategory: contains

      MarcDifferenceModel --> DifferenceStatusLogModel : returns >
      MarcDifferenceModel --> DifferenceStatus : returns >

      class DifferenceStatusLogModel {
        +id: Integer
        +status: DifferenceStatus
        +changedBy: String
        +changedAt: Timestamp
      }

      DifferenceStatusLogModel --> DifferenceStatus : contains

      class GroupModel
      class UserModel

      class CatalogRecordListModel {
        +id: Integer
        +name: String
        +description: String | None = None
        +query: CatalogRecordQuery
        +createdBy: String
        +hasUndecidedDifferences: Boolean | None = None
        +assignedToGroups(): List<GroupModel>
        +assignedToUsers(): List<UserModel>
      }

      class CatalogRecordListGroupModel {
        +listId: Integer
        +groupId: Integer
      }

      class CatalogRecordListUserModel {
        +listId: Integer
        +username: String
      }
    }

    class CatalogRecordRepository {
      +get(mainRecordId: String): PrimaryRecordModel
      +listAll(): List<PrimaryRecordModel>
      +saveRecord(catalogRecord: CatalogRecordModel): CatalogRecordModel
      +savePrimaryRecord(mainRecord: PrimaryRecordModel): PrimaryRecordModel
      +saveAuthorityRecord(authorityRecord: AuthorityRecordModel): AuthorityRecordModel
      +archive(mainRecordId: String): PrimaryRecordModel
      +delete(mainRecordId: String): PrimaryRecordModel
      +index(mainRecord: PrimaryRecordModel): PrimaryRecordModel
      +search(query: CatalogRecordQuery): CatalogRecordResponse
    }

    CatalogRecordRepository --> CatalogRecordQuery : uses

    CatalogRecordRepository --> PrimaryRecordModel : manages >
    CatalogRecordRepository --> CatalogRecordModel : manages >
    CatalogRecordRepository --> PrimaryRecordModel : manages >
    CatalogRecordRepository --> AuthorityRecordModel : manages >

    CatalogRecordRepository --> CatalogRecordResponse : returns >

    class MarcDifferenceRepository {
      +get(differenceId: Integer): MarcDifferenceModel
      +getRecordDifferences(mainRecordId: String): List<MarcDifferenceModel>
      +save(difference: MarcDifferenceModel): MarcDifferenceModel
    }

    MarcDifferenceRepository --> MarcDifferenceModel : manages >

    class CatalogRecordListRepository {
      +get(listId: Integer): CatalogRecordList
      +listAll(): List<CatalogRecordList>
      +save(listId: Integer, list: CatalogRecordListModel): CatalogRecordListModel
      +delete(listId: Integer): CatalogRecordListModel
    }
  }

  package "Connectors" {
    class CatalogsConnector
    class MarcComparatorConnector
  }

  package "Services" {
    class CatalogRecordService {
      +syncCatalogRecord(catalogRecord: CatalogRecordModel): CatalogRecordModel
      +syncPrimaryRecord(mainRecord: PrimaryRecordModel): PrimaryRecordModel
      +archiveInactiveRecords(): None
    }

    CatalogRecordService ..>  CatalogRecordRepository : calls >
    CatalogRecordService ..> CatalogsConnector : calls >

    class MarcDifferenceService {
      +syncRecordDifferences(authorityRecord: AuthorityRecordModel): AuthorityRecordModel
    }

    MarcDifferenceService ..>  MarcDifferenceRepository : calls >
    MarcDifferenceService ..>  MarcComparatorConnector : calls >

    class CatalogRecordListService {
      +syncUndecidedFlag(listId: Integer): None
    }

    CatalogRecordListService ..> CatalogRecordListRepository : calls >
  }

  package "API Controllers" {

    class CatalogRecordController {
      +search(query: CatalogRecordQuery): CatalogRecordResponse
      +getDetails(mainRecordId: String): PrimaryRecordDetails
      +delete(mainRecordId: String): MessageResponse
    }

    CatalogRecordController --> CatalogRecordQuery : uses

    CatalogRecordController --> CatalogRecordResponse : returns >
    CatalogRecordController --> PrimaryRecordDetails : returns >
    CatalogRecordController --> CatalogRecordList : returns >
    CatalogRecordController --> MessageResponse : returns >

    CatalogRecordController ..> CatalogRecordRepository : calls >
    CatalogRecordController ..> CatalogRecordTaskService : calls >

    class MarcDifferenceController {
      +setPendingFix(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
      +unsetPendingFix(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
      +approveDifference(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
      +revokeDifferenceApproval(differenceId: Integer): ItemMessageResponse<PrimaryRecord, Task>
    }

    MarcDifferenceController --> ItemMessageResponse : returns >
    MarcDifferenceController --> PrimaryRecord : returns >
    MarcDifferenceController --> Task : returns >

    class CatalogRecordListController {
      +createList(list: CatalogRecordListEdit): ItemMessageResponse<CatalogRecordList>
      +updateList(listId: Integer, list: CatalogRecordListEdit): ItemMessageResponse<CatalogRecordList>
      +deleteList(listId: Integer): MessageResponse
      +getLists(): List<CatalogRecordList>
    }

    CatalogRecordListController --> CatalogRecordListEdit : uses
    CatalogRecordListController --> ItemMessageResponse : returns >
    CatalogRecordListController --> PrimaryRecord : returns >
    CatalogRecordListController --> Task : returns >
  }
}

@enduml
