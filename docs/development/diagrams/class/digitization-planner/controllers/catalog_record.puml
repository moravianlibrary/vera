@startuml VERA - Class Diagram - Catalog Record Controller

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Types" {

    enum CatalogRecordStatus {
      Valid
      Invalid
      Unreachable
      Synced
      Archived
      Revived
    }
    
    enum CatalogRecordTask {
      IgnoreMissingAuthority
      Reindex
      Sync
      ReevaluateDifferences
      ArchiveInactive
    }
  }

  package "Schemas" {

    entity AuthorityRecordBase {
      +authorityBase: String
      +authorityId: String | None = None
      +status: List<CatalogRecordStatus>
    }

    AuthorityRecordBase --> CatalogRecordStatus : contains

    entity PrimaryRecordBase {
      +id: String
      +base: String
      +systemNumber: String
      +status: List<CatalogRecordStatus>
      +addedAt: Timestamp
      +updatedAt: Timestamp
      +hasAddedDocuments: Boolean
      +hasActiveDocuments: Boolean
      ' Also others configurable attributes
    }

    PrimaryRecordBase --> CatalogRecordStatus : contains

    entity AuthorityRecord extends AuthorityRecordBase {
      +differences: List<MarcDifference>
    }

    AuthorityRecord --> MarcDifference : contains

    entity PrimaryRecord extends PrimaryRecordBase {
      +authorityRecords: List<AuthorityRecord>
    }

    PrimaryRecord --> AuthorityRecord : contains

    entity CatalogRecordStatusLog {
      +status: CatalogRecordStatus
      +changedAt: Timestamp
    }

    CatalogRecordStatusLog --> CatalogRecordStatus : contains

    entity AuthorityRecordDetails extends AuthorityRecordBase {
      +marc: MarcRecord
      +differences: List<MarcDifferenceDetails>
      +statusLog: List<CatalogRecordStatusLog>
    }

    AuthorityRecordDetails --> MarcDifferenceDetails : contains
    AuthorityRecordDetails --> CatalogRecordStatusLog : contains

    entity PrimaryRecordDetails extends PrimaryRecord {
      +marc: MarcRecord
      +statusLog: List<CatalogRecordStatusLog>
    }

    PrimaryRecordDetails --> CatalogRecordStatusLog : contains

    entity CatalogRecordQuery
    entity CatalogRecordResponse
    CatalogRecordResponse --> PrimaryRecord : contains

    entity MessageResponse
    entity ItemMessageResponse
    entity Task
    entity RecurringTask
  }

  package "Repositories" {

    package "Model" {

      class CatalogRecordModel {
        +id: String
        +base: String
        +systemNumber: String
        +marc: MarcRecord
        +isUnreachable: Boolean
        +isArchived: Boolean = False
        +isValid: Boolean | None = None
        +statusLog(): List<CatalogRecordStatusLogModel>
      }

      CatalogRecordModel --> CatalogRecordStatusLogModel : contains

      class CatalogRecordStatusLogModel {
        +id: String
        +status: CatalogRecordStatus
        +changedAt: Timestamp
      }

      CatalogRecordStatusLogModel --> CatalogRecordStatus : contains

      class PrimaryRecordModel {
        +id: String
        +addedAt: Timestamp
        +updatedAt: Timestamp
        +hasAddedDocuments(): Boolean
        +hasActiveDocuments(): Boolean
        +catalogRecord(): CatalogRecordModel
        +authorityRecords(): List<AuthorityRecordModel>
      }

      PrimaryRecordModel --> CatalogRecordModel : returns >
      PrimaryRecordModel --> AuthorityRecordModel : returns >

      class AuthorityRecordModel {
        +primaryId: String
        +authorityBase: String
        +authorityId: String | None = None
        +authorityRecord(): CatalogRecordModel | None
        +differences(): List<MarcDifferenceModel> | None
      }

      AuthorityRecordModel --> CatalogRecordModel : returns >
      AuthorityRecordModel --> MarcDifferenceModel : returns >
    }

    class CatalogRecordRepository {
      +getById(mainRecordId: String): PrimaryRecordModel | None
      +listAll(): List<PrimaryRecordModel>
      +getInactiveRecords(): List<PrimaryRecordModel>
      +saveRecord(catalogRecord: CatalogRecordModel): CatalogRecordModel
      +savePrimaryRecord(mainRecord: PrimaryRecordModel): PrimaryRecordModel
      +saveAuthorityRecord(authorityRecord: AuthorityRecordModel): AuthorityRecordModel
      +delete(mainRecordId: String): PrimaryRecordModel
      +index(mainRecord: PrimaryRecordModel): PrimaryRecordModel
      +search(query: CatalogRecordQuery): CatalogRecordResponse
    }

    CatalogRecordRepository --> CatalogRecordQuery : uses

    CatalogRecordRepository --> CatalogRecordModel : manages >
    CatalogRecordRepository --> PrimaryRecordModel : manages >
    CatalogRecordRepository --> AuthorityRecordModel : manages >

    CatalogRecordRepository --> CatalogRecordResponse : returns >
  }

  package "Adapters" {
    class CatalogsConnector
  }

  package "Services" {

    class CatalogRecordService {
      +syncCatalogRecord(catalogRecord: CatalogRecordModel): CatalogRecordModel
      +syncPrimaryRecord(primaryRecord: PrimaryRecordModel): PrimaryRecordModel
      +ignoreMissingAuthority(authorityRecord: AuthorityRecordModel): AuthorityRecordModel
      +reindex(primaryRecord: PrimaryRecordModel): PrimaryRecordModel
      +reevaluateDifferences(primaryRecord: PrimaryRecordModel): PrimaryRecordModel
    }

    CatalogRecordService --> CatalogRecordModel : uses
    CatalogRecordService --> PrimaryRecordModel : uses
    CatalogRecordService --> AuthorityRecordModel : uses

    CatalogRecordService ..> CatalogRecordRepository : calls >
    CatalogRecordService ..> MarcDifferenceRepository : calls >
    CatalogRecordService ..> CatalogsConnector : calls >
  }

  package "API Controllers" {

    entity ScheduleTaskParams {
      +taskType: CatalogRecordTask
      +query: CatalogRecordQuery | None = None
      +base: String | None = None
    }

    ScheduleTaskParams --> CatalogRecordTask : contains
    ScheduleTaskParams --> CatalogRecordQuery : contains

    entity ScheduleRecurringTaskParams extends ScheduleTaskParams {
      +cronExpression: String
    }

    entity UpdateRecurringTaskParams extends ScheduleRecurringTaskParams {
      +recurringTaskId: Integer
    }

    class CatalogRecordController {
      +search(query: CatalogRecordQuery): CatalogRecordResponse
      +getDetails(mainRecordId: String): PrimaryRecordDetails
      +delete(mainRecordId: String): MessageResponse
      +scheduleTask(params: ScheduleTaskParams): ItemMessageResponse<Task>
      +scheduleRecurringTask(params: ScheduleRecurringTaskParams): RecurringTask
      +updateRecurringTask(params: UpdateRecurringTaskParams): RecurringTask
    }

    CatalogRecordController --> CatalogRecordQuery : uses
    CatalogRecordController o-- CreateTaskParams : uses
    CatalogRecordController o-- CreateRecurringTaskParams : uses
    CatalogRecordController o-- UpdateRecurringTaskParams : uses

    CatalogRecordController --> CatalogRecordResponse : returns >
    CatalogRecordController --> PrimaryRecordDetails : returns >
    CatalogRecordController --> MessageResponse : returns >
    CatalogRecordController --> ItemMessageResponse : returns >
    CatalogRecordController --> Task : returns >
    CatalogRecordController --> RecurringTask : returns >

    CatalogRecordController ..> CatalogRecordRepository : calls >
  }
}

@enduml
