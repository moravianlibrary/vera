@startuml VERA - Class Diagram - Catalog Record Controller

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Types" {

    enum CatalogRecordStatus {
      Valid
      Invalid
      Unreachable
      Synced
      Archived
      Revived
    }
    
    enum DifferenceStatus {
      Undecided
      PendingFix
      Fixed
      Approved
      ApprovalRevoked
    }

    enum DifferenceType
    enum DifferenceCategory
  }

  package "Schemas" {

    entity AuthorityRecordBase {
      +authorityBase: String
      +authorityId: String | None = None
      +status: List<CatalogRecordStatus>
    }

    AuthorityRecordBase --> CatalogRecordStatus : contains

    entity MainRecordBase {
      +id: String
      +base: String
      +systemNumber: String
      +status: List<CatalogRecordStatus>
      +addedAt: Timestamp
      +updatedAt: Timestamp
      +hasAddedDocuments: Boolean
      +hasActiveDocuments: Boolean
      ' Also others configurable attributes
    }

    MainRecordBase --> CatalogRecordStatus : contains

    entity MarcDifference {
      +type: DifferenceType
      +category: DifferenceCategory
      +field: String
      +subfield: String | None
      +currentStatus: DifferenceStatus
    }

    MarcDifference --> DifferenceType : contains
    MarcDifference --> DifferenceCategory : contains
    MarcDifference --> DifferenceStatus : contains

    entity AuthorityRecord extends AuthorityRecordBase {
      +differences: List<MarcDifference>
    }

    AuthorityRecord --> MarcDifference : contains

    entity MainRecord extends MainRecordBase {
      +authorityRecords: List<AuthorityRecord>
    }

    MainRecord --> AuthorityRecord : contains

    entity MarcDifferenceStatusLog {
      +status: DifferenceStatus
      +changedBy: String
      +changedAt: Timestamp
    }

    MarcDifferenceStatusLog --> DifferenceStatus : contains

    entity MarcDifferenceDetails extends MarcDifference {
      +indicator1: String | None
      +indicator2: String | None
      +value: String | None
      +statusLog: List<MarcDifferenceStatusLog>
      ' Also others configurable attributes
    }

    MarcDifferenceDetails --> MarcDifferenceStatusLog : contains

    entity CatalogRecordStatusLog {
      +status: CatalogRecordStatus
      +changedAt: Timestamp
    }

    CatalogRecordStatusLog --> CatalogRecordStatus : contains

    entity AuthorityRecordDetails extends AuthorityRecordBase {
      +marc: MarcRecord
      +differences: List<MarcDifferenceDetails>
      +statusLog: List<CatalogRecordStatusLog>
    }

    AuthorityRecordDetails --> MarcDifferenceDetails : contains
    AuthorityRecordDetails --> CatalogRecordStatusLog : contains

    entity MainRecordDetails extends MainRecord {
      +marc: MarcRecord
      +statusLog: List<CatalogRecordStatusLog>
    }

    MainRecordDetails --> CatalogRecordStatusLog : contains

    entity CatalogRecordQuery
    entity CatalogRecordResponse
    CatalogRecordResponse --> MainRecord : contains

    entity CatalogRecordListEdit {}

    entity CatalogRecordList extends CatalogRecordListEdit {}
  }

  package "Repositories" {

    package "Model" {

      class CatalogRecordModel {
        +id: String
        +base: String
        +systemNumber: String
        +marc: MarcRecord
        +isUnreachable: Boolean
        +isArchived: Boolean = False
        +isValid: Boolean | None = None
        +statusLog(): List<CatalogRecordStatusLogModel>
      }

      CatalogRecordModel --> CatalogRecordStatusLogModel : contains

      class CatalogRecordStatusLogModel {
        +id: String
        +status: CatalogRecordStatus
        +changedAt: Timestamp
      }

      CatalogRecordStatusLogModel --> CatalogRecordStatus : contains

      class MainRecordModel {
        +id: String
        +addedAt: Timestamp
        +updatedAt: Timestamp
        +hasAddedDocuments(): Boolean
        +hasActiveDocuments(): Boolean
        +catalogRecord(): CatalogRecordModel
        +authorityRecords(): List<AuthorityRecordModel>
      }

      MainRecordModel --> CatalogRecordModel : returns >
      MainRecordModel --> AuthorityRecordModel : returns >

      class AuthorityRecordModel {
        +mainId: String
        +authorityBase: String
        +authorityId: String | None = None
        +authorityRecord(): CatalogRecordModel
        +differences(): List<MarcDifferenceModel>
      }

      AuthorityRecordModel --> CatalogRecordModel : returns >
      AuthorityRecordModel --> MarcDifferenceModel : returns >

      class MarcDifferenceModel {
        +id: Integer
        +mainId: String
        +authorityId: String
        +field: String
        +type: DifferenceType
        +category: DifferenceCategory
        +subfield: String | None = None
        +indicator1: String | None = None
        +indicator2: String | None = None
        +value: String | None = None
        +pendingFix: Boolean = False
        +approved: Boolean = False
        +statusLog(): List<DifferenceStatusLogModel>
        +currentStatus(): List<DifferenceStatus>
      }

      MarcDifferenceModel --> DifferenceType : contains
      MarcDifferenceModel --> DifferenceCategory: contains

      MarcDifferenceModel --> DifferenceStatusLogModel : returns >
      MarcDifferenceModel --> DifferenceStatus : returns >

      class DifferenceStatusLogModel {
        +id: Integer
        +status: DifferenceStatus
        +changedBy: String
        +changedAt: Timestamp
      }

      DifferenceStatusLogModel --> DifferenceStatus : contains
    }

    class CatalogRecordRepository {
      +get(mainRecordId: String): MainRecordModel
      +listAll(): List<MainRecordModel>
      +saveRecord(catalogRecord: CatalogRecordModel): CatalogRecordModel
      +saveMainRecord(mainRecord: MainRecordModel): MainRecordModel
      +saveAuthorityRecord(authorityRecord: AuthorityRecordModel): AuthorityRecordModel
      +saveMarcDifference(marcDifference: MarcDifferenceModel): MarcDifferenceModel
      +archive(mainRecordId: String): MainRecordModel
      +delete(mainRecordId: String): MainRecordModel
      +index(mainRecord: MainRecordModel): MainRecordModel
      +search(query: CatalogRecordQuery): CatalogRecordResponse
    }
  }

  package "API Controllers" {

    class CatalogRecordController {
      +archive(mainRecordId: String): MessageResponse
      +delete(mainRecordId: String): MessageResponse
      +search(query: CatalogRecordQuery): CatalogRecordResponse
      +getDetails(mainRecordId: String): MainRecordDetails

      +setPendingFix(differenceId: Integer): ItemMessageResponse<MainRecord, Task>
      +unsetPendingFix(differenceId: Integer): ItemMessageResponse<MainRecord, Task>
      +approveDifference(differenceId: Integer): ItemMessageResponse<MainRecord, Task>
      +revokeDifferenceApproval(differenceId: Integer): ItemMessageResponse<MainRecord, Task>
    }

    CatalogRecordController ..> CatalogRecordRepository : calls >
  }
}

@enduml
