skinparam nodesep 150
skinparam linetype ortho
top to bottom direction

package "Digitization Planner" {

  package "Schemas" {

    entity Translation {
      +language: String
      +text: String
    }

    entity CatalogRecordPropertyEdit {
      +name: String
      +translations: List<Translation>
      +parseFunction: PythonFunction
      +useInCatalogRecords: Boolean
      +useInCatalogRecordSearch: Boolean
      +useInDocuments: Boolean
      +useInDocumentSearch: Boolean
    }

    CatalogRecordPropertyEdit o-- Translation : contains

    entity CatalogRecordProperty extends CatalogRecordPropertyEdit {
      +id: Integer
      +isRequired: Boolean
    }

    entity MessageResponse
    entity ItemMessageResponse
  }
  
  package "Repositories" {
  
    package "Model" {
    
      class CatalogRecordPropertyModel {
        +id: Integer
        +name: String
        +translations: List<Translation>
        +parseFunction: String
        +useInCatalogRecords: Boolean
        +useInCatalogRecordSearch: Boolean
        +useInDocuments: Boolean
        +useInDocumentSearch: Boolean
        +isRequired: Boolean = False
      }
    }

    class CatalogRecordPropertyRepository {
      +get(propertyId: Integer): CatalogRecordPropertyModel
      +listAll(): List<CatalogRecordPropertyModel>
      +save(property: GroupModel): GroupModel
      +delete(groupId: Integer): GroupModel
    }

    CatalogRecordPropertyRepository --> CatalogRecordPropertyModel : manages >

    class CatalogRecordRepository
  }

  package "Services" {

    class CatalogRecordPropertyService {
      +validate(script: PythonScript): None
      +test(script: PythonScript, recordId: String): List<DocumentIdentifiers>
    }

    CatalogRecordPropertyService ..> CatalogRecordRepository : calls >
  }
  
  package "API Controllers" {

    class CatalogRecordPropertyController {
      +test(property: CatalogRecordPropertyEdit, recordId: String): ItemMessageResponse<String>
      +create(property: CatalogRecordPropertyEdit): ItemMessageResponse<CatalogRecordProperty>
      +update(propertyId: Integer, property: CatalogRecordPropertyEdit): ItemMessageResponse<CatalogRecordProperty>
      +delete(propertyId: Integer): MessageResponse
      +listAll(): List<CatalogRecordProperty>
    }

    CatalogRecordPropertyController --> CatalogRecordPropertyEdit : uses

    CatalogRecordPropertyController --> CatalogRecordProperty : returns >
    CatalogRecordPropertyController --> ItemMessageResponse : returns >
    CatalogRecordPropertyController --> MessageResponse : returns >

    CatalogRecordPropertyController ..> CatalogRecordPropertyService : calls >
    CatalogRecordPropertyController ..> CatalogRecordPropertyRepository : calls >
  }
}

@enduml
