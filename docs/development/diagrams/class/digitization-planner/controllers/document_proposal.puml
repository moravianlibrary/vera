@startuml VERA - Class Diagram - Document Proposal Controller

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Types" {

    enum IdentifierType {
      Barcode
      SystemNumber
      ISXN
      Signature
    }

    enum DocumentProposalStatus {
      NotEligible
      Pending
      Approved
      Rejected
    }

    enum ProposalIntakeStatus {
      Enqueued
      Processing
      AmbiguousIssues
      AllIssuesResolved
      Processed
    }

    enum DocumentEligibilityStatus {
      Ready
      ActiveDuplicate
      DigitizationForbidden

      ' Ignorable status
      InDigitization
      FullyProcessedDuplicate

      ' Failure status
      CatalogRecordFailure
      DigitizationRegistryFailure
      InternalFailure
    }

    enum ProposalSource {
      Batch
      Direct
    }
  }

  package "Schemas" {

    entity ProposalCreate {
      +catalogRecordId: String
      +issueId: String | None
      +reasonMessage: String
    }

    entity ProposalIntakeCreate {
      +identifierType: IdentifierType
      +identifierValue: String
    }

    ProposalIntakeCreate --> IdentifierType : contains
    
    entity Proposal {
      +id: String 

      +catalogRecordId: String
      +issueId: String

      +reasonMessage: String
      +createdBy: String
      +createdAt: Timestamp

      +eligibilityStatus: DocumentEligibilityStatus | None
      +errorMessage: String | None
      +digitizationRecords: List<DigitizationRecord> | None

      +requestedException: Boolean | None
      +exceptionRequestMessage: String | None

      +status: DocumentProposalStatus
      +statusUpdatedBy: String | None
      +statusUpdatedAt: Timestamp | None
      +statusUpdateMessage: String | None

      +isArchived: Boolean
    }

    entity ProposalIntake extends ProposalIntakeCreate {
      +id: Integer
      +status: ProposalIntakeStatus
      +proposal: Proposal | None
    }
    
    entity ProposalIntakeBatch {
      +id: Integer
      +name: String | None
      +reasonMessage: String
      +createdBy: String
      +createdAt: Timestamp
      +proposalIntakes: List<ProposalIntake>
    }

    ' unique ID (e.g. "intake-123" or "proposal-456")
    entity UnifiedProposal {
      +id: String
      +source: ProposalSource

      +reasonMessage: String
      +createdBy: String
      +createdAt: Timestamp

      +proposalId: Integer | None
      +catalogRecordId: String | None
      +issueId: String | None

      +batchId: Integer | None
      +intakeId: Integer | None
      +batchName: String | None
      +intakeStatus: ProposalIntakeStatus | None

      +eligibilityStatus: DocumentEligibilityStatus | None
      +errorMessage: String | None
      +digitizationRecords: List<DigitizationRecord> | None

      +requestedException: Boolean | None
      +exceptionRequestMessage: String | None

      +status: DocumentProposalStatus
      +statusUpdatedBy: String | None
      +statusUpdatedAt: Timestamp | None
      +statusUpdateMessage: String | None

      +isArchived: Boolean
    }

    DocumentProposal --> DocumentProposalStatus : contains
    DocumentProposal --> DocumentEligibilityStatus : contains

    entity DocumentProposalQuery
    entity DocumentProposalResponse
    DocumentProposalResponse --> DocumentProposal : contains

    entity CurrentUser
    entity MessageResponse
  }

  package "Repositories" {

    package "Model" {

      class ProposalIntakeBatchModel {
        +id: Integer
        +name: String | None = None
        +reasonMessage: String
        +createdBy: String
        +createdAt: Timestamp = Timestamp::Now
      }

      class ProposalIntakeModel {
        +id: Integer
        +batchId: Integer
        +identifierType: IdentifierType
        +identifierValue: String
        +status: ProposalIntakeStatus = ProposalIntakeStatus::Enqueued
        +eligibilityStatus: DocumentEligibilityStatus | None = None
        +errorMessage: String | None = None
        +digitizationRecords: List<DigitizationRecord> | None = None
      }

      ProposalIntakeModel --> IdentifierType : contains
      ProposalIntakeModel --> ProposalIntakeStatus : contains
      ProposalIntakeModel --> DocumentEligibilityStatus : contains

      class ProposalModel {
        +id: Integer
        +catalogRecordId: String
        +issueId: String | None
        +reasonMessage: String
        +createdBy: String
        +createdAt: Timestamp = Timestamp::Now
        +requestedException: Boolean = False
        +exceptionRequestMessage: String | None = None
        +status: DocumentProposalStatus = DocumentProposalStatus::Pending
        +isArchived: Boolean = False
      }

      ProposalModel --> DocumentProposalStatus : contains

      class ProposalStatusLog {
        +proposalId: Integer
        +newStatus: DocumentProposalStatus
        +updatedBy: String
        +updatedAt: Timestamp
        +message: String | None
      }

      ProposalStatusLog --> ProposalStatus : contains

      class IntakeProposalAssociation {
        +proposalId: Integer
        +intakeId: Integer
      }

      class ProjectProposalAssociation {
        +proposalId: Integer
        +projectId: Integer
        +categoryId: Integer
      }
    }

    class DocumentProposalRepository {
      +get(proposalId: Integer): DocumentProposalModel
      +save(proposal: DocumentProposalModel): DocumentProposalModel
      +delete(proposalId: Integer): DocumentProposalModel
      +search(query: DocumentProposalQuery): DocumentProposalsResponse
      +index(proposal: DocumentProposalModel): DocumentProposalModel
      +recreateIndex(): None
    }

    DocumentProposalRepository --> DocumentProposalModel : manages >
    DocumentProposalRepository --> DocumentProposalStatusLog : tracks changes >
  }

  package "Services" {

    entity EnqueueDocumentProposalResult {
      +enqueued: Integer
      +alreadyEnqueued: Integer
    }

    entity AcceptProposalResult {
      +accepted: Integer
      +reaccepted: Integer
      +alreadyAccepted: Integer
    }

    entity DeclineProposalResult {
      +declined: Integer
      +alreadyAccepted: Integer
      +alreadyDeclined: Integer
    }

    class CatalogRecordService

    class DocumentProposalService {
      +propose(proposals: <ProposalCreate>): EnqueueDocumentProposalResult
      +enqueue_proposals(proposals: List<DocumentProposalAsyncCreate>): EnqueueDocumentProposalResult
      +restrictQuery(query: DocumentProposalQuery, user: CurrentUser): DocumentProposalQuery
      +acceptProposal(query: DocumentProposalQuery, categoryId: Integer): AcceptProposalResult
      +declineProposal(query: DocumentProposalQuery): DeclineProposalResult
    }

    DocumentProposalService --> DocumentProposalCreate : uses
    DocumentProposalService --> DocumentProposalQuery : uses
    DocumentProposalService --> CurrentUser : uses

    DocumentProposalService o-- EnqueueDocumentProposalResult : returns >
    DocumentProposalService o-- AcceptProposalResult : returns >
    DocumentProposalService o-- DeclineProposalResult : returns >

    DocumentProposalService ..> DocumentProposalRepository : calls >
    DocumentAdditionService ..> CatalogRecordService : calls >
  }

  package "API Controllers" {

    ' Set limits for the number of proposals
    ' that can be created in a single request
    ' or in a specific time period
    
    class DocumentProposalController {
      +search(query: DocumentProposalQuery): DocumentProposalResponse
      +propose(proposals: <ProposalCreate>): MessageResponse
      +enqueue_intakes_to_new_batch(intakes: List<ProposalIntakeCreate>, batchName: String | None, reasonMessage: String): MessageResponse
      +enqueue_intakes(intakes: List<ProposalIntakeCreate>, batchId: Integer): MessageResponse
      +approveProposals(query: DocumentProposalQuery, categoryId: Integer): MessageResponse
      +rejectProposals(query: DocumentProposalQuery): MessageResponse
      +archive(query: DocumentProposalQuery): MessageResponse
      +delete(query: DocumentProposalQuery): MessageResponse
    }

    DocumentProposalController --> DocumentProposalCreate : uses
    DocumentProposalController --> DocumentProposalQuery : uses

    DocumentProposalController --> MessageResponse : returns >
    DocumentProposalController --> DocumentProposalResponse : returns >

    DocumentProposalController ..> DocumentProposalService : calls >
    DocumentProposalController ..> DocumentProposalRepository : calls >
  }
}

@enduml
