@startuml VERA - Class Diagram - User Controller

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
skinparam linetype ortho
top to bottom direction

package "Digitization Planner" {

  package "Schemas" {

    entity Role
    entity Group
    entity UserSettings
  
    entity CurrentUser {
      +username: String
      +settings: UserSettings
      +role: Role
      +groups: List<Group>
    }

    entity UserNotifications {
      +taskChanges: List<Task>
      +enqueuedDocumentAdditions: Integer
      +processedDocumentAdditions: Integer
      +catalogRecordListsChanged: List<CatalogRecordList>
    }

    entity KeycloakSettings {
      +serverUrl: String
      +realmName: String
      +clientId: String
      +clientSecret: String
      +issuerClientId: String
      +usernameField: String | None
      +roleNamesField: String | None
    }

    entity AuthSettings {
      +keycloakSettings: KeycloakSettings | None
    }

    CurrentUser --> Role : has
    CurrentUser --> Group : belongs to
    CurrentUser --> UserSettings : has

    entity MessageResponse
  }
  
  package "Repositories" {
  
    package "Model" {

      class GroupModel

      class UserModel {
        +username: String
        +settings: UserSettings
        +notificationsLastChecked: Timestamp
        +groups(): List<GroupModel>
      }

      UserModel --> GroupModel : returns >
    }

    class UserRepository {
      +get(username: String): UserModel
      +save(user: UserModel): UserModel
    }

    UserRepository --> UserModel : manages

    class DocumentAdditionRepository
    class TaskRepository
    class CatalogRecordRepository
  }
  
  package "Services" {

    class UserService {
      +getCurrentUser(token: String): CurrentUser
      +getNotifications(username: String): UserNotifications
    }

    package "Auth" {

      interface AuthServiceInterface {
        +getUserInfo(token: String): Map<String, Object>
        +parseUsername(userInfo: Map<String, Object>): String
        +parseRoleNames(userInfo: Map<String, Object>): List<String>
      }

      class KeycloakService implements AuthServiceInterface {
        +KeycloakService(settings: KeycloakSettings)
      }

      class AuthService implements AuthServiceInterface {
        +AuthService(settings: AuthSettings)
      }

      KeycloakService --> KeycloakSettings : uses
      AuthService --> AuthSettings : uses

      AuthService --> KeycloakService : manages >
    }

    UserService --> CurrentUser : returns >
    UserService --> UserNotifications : returns >

    UserService ..> UserRepository : calls >

    UserService ..> AuthService : calls >
    UserService ..> UserRepository : calls >
    UserService ..> DocumentAdditionRepository : get additions changes >
    UserService ..> TaskRepository : get tasks changes >
    UserService ..> CatalogRecordRepository : get catalog records lists changes >
  }

  package "Security" {
    class AccessControlEnforcer {
      +AccessControlEnforcer(permission: Permission, token: String)
    }

    AccessControlEnforcer --> AuthService : calls >

    class OwnershipAccessControlEnforcer {
      +OwnershipControlEnforcerEnforcer(permission: OwnershipPermission, token: String)
    }

    OwnershipAccessControlEnforcer --> AuthService : calls >
  }
  
  package "API Controllers" {

    class UserController {
      +getCurrentUser(): CurrentUser
      +getNotifications(): UserNotifications
      +getSettings(): UserSettings
      +saveSettings(settings: UserSettings): MessageResponse
    }

    UserController --> CurrentUser : returns >
    UserController --> UserNotifications : returns >
    UserController --> UserSettings : returns >
    UserController --> MessageResponse : returns >

    UserController ..> UserService : calls >
    UserController ..> UserRepository : calls >
  }
}

@enduml

