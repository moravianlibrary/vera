@startuml VERA - Class Diagram - Documents

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
top to bottom direction

package "Digitization Planner" {

  package "Types" {

    enum CategoryTask {
      Reindex
      ReindexAll
      ExecuteScript
    }

    enum IntentionStatus {
      Proposed
      Accepted
      Declined
    }

  }

  package "Schemas" {

    entity CategoryEdit {
      +name: String
      +descripton: String | None
      +assignable: Boolean
      +extractWhole: Boolean
    }

    entity CategoryDistribution {
      distributionId: Integer
      percentage: Float
    }

    entity Category extends CategoryEdit {
      +id: Integer
      +intentionId: Integer | None
      +parentId: Integer | None
      +level: Integer
      +disabled: Boolean
      +archived: Boolean
      +scriptId: Integer | None
      +assignedToGroups(): List<GroupModel>
      +assignedToUsers(): List<UserName>
      +hasScript(): Boolean
      +distributions: List<CategoryDistribution>
      +countTotalPages(): Integer
      +countTotalDocuments(): Integer
      +countExtractablePages(): Integer
      +countExtractableDocuments(): Integer
      +countExtractedPages(): Integer
      +countExtractedDocuments(): Integer
    }

    entity Script {}

    entity DistributionEdit {
      +name: String
      +active: Boolean
    }

    entity Distribution extends CategoriesDistributionEdit {
      +id: Integer
    }

    entity CategoryDistribution {
      categoryId: Integer
      percentage: Float
    }

    entity IntentionEdit {
      +name: String
      +descripton: String | None
      +targetPageCount: Integer | None
      +startDate: Date | None
      +endDate: Date | None
    }

    entity Intention extends IntentionEdit {
      +id: Integer
      +isProject: Boolean
      +projectOwner: String | None
      +projectStatus: IntentionStatus | None
      +archived: Boolean
    }

    ' DocumentProposalCreate --> IdentifierType : contains
  }

  package "Repositories" {

    package "Model" {

      class CategoryModel {
        +id: Integer
        +name: String
        +descripton: String | None
        +intentionId: Integer | None = None
        +parentId: Integer | None = None
        +level: Integer = 0
        +assignable: Boolean = False
        +extractWhole: Boolean = False
        +disabled: Boolean = False
        +archived: Boolean = False
        +assignedToGroups(): List<GroupModel>
        +assignedToUsers(): List<UserName>
        +hasScript(): Boolean
        +totalPageCount(): Integer
        +totalDocuments(): Integer
        +extractablePageCount(): Integer
        +extractableDocuments(): Integer
        +extractedPageCount(): Integer
        +extractedDocuments(): Integer
      }

      class CategoryScriptModel {
        +categoryId: Integer
        +scriptFile: BashFile
      }

      class CategoryGroupModel {
        +categoryId: Integer
        +groupId: Integer
      }

      class CategoryUserModel {
        +categoryId: Integer
        +username: String
      }

      class DistributionModel {
        +id: Integer
        +name: String
        +active: Boolean
      }

      class CategoryDistributionModel {
        +categoryId: Integer
        +distributionId: Integer
        +percentage: Float = 0
      }

      class IntentionModel {
        +id: Integer
        +name: String
        +descripton: String | None = None
        +targetPageCount: Integer | None = None
        +startDate: Date | None = None
        +endDate: Date | None = None
        +isProject: Boolean = False
        +projectOwner: String | None
        +projectStatus: IntentionStatus | None
        +archived: Boolean = False
      }

      class ProjectStatusModel {
        +intentionId: Integer
        +newStatus: IntentionStatus
        +changedBy: String
        +changedAt: Timestamp
        +reason: String
      }
    }

    class CategoryRepository {
      +get(categoryId: Integer): CategoryModel
      +listAll(): List<CategoryModel>
      +save(category: CategoryModel): CategoryModel
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }

    CategoryRepository --> CategoryModel : manages >
    CategoryRepository --> CategoryScriptModel : manages >
    CategoryRepository --> CategoryGroupModel : manages >
    CategoryRepository --> CategoryUserModel : manages >
    CategoryRepository --> DistributionModel : gets >
    CategoryRepository --> CategoryDistributionModel : manages >

    class DistributionRepository {
      +get(distributionId: Integer): DistributionModel
      +listAll(): List<DistributionModel>
      +save(distribution: DistributionModel): DistributionModel
      +delete(distributionId: Integer): DistributionModel
    }

    DistributionRepository --> DistributionModel : manages >

    class DigitizationListRepository {
      +get():
      +save():
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }
  }

  package "Services" {

    class CategoryService {
      +create(category: CategoryEdit): CategoryModel
      +changeParent(
        categoryId: Integer,
        fromParent: Integer | None,
        toParent: Integer | None
      ): None
      +updateScript(categoryId: Integer, script: Script | None): CategoryModel
      +restrictQuery(query: CategoryQuery, user: User): CategoryQuery
    }

    CategoryService --> CategoryRepository : uses>

    class CategoryTaskService {
      +reindex(task: Task): None
      +reindexAll(task: Task): None
      +addDocumentsUsingScript(task: Task): None
    }

    CategoryTaskService --> CategoryTaskRepository : uses>
    CategoryTaskService --> DocumentProposalRepository : uses>
  }

  package "API Controllers" {

    class CategoryController {
      +create(category: CategoryEdit): MessageResponse
      +update(categoryId: Integer, category: CategoryEdit): ItemMessageResponse<Category>
      +changeDistribution(categoryId: Integer, distributionId: Integer, distribution: List<CategoryDistribution>): MessageResponse
      +changeParent(categoryId: Integer, fromParent: Integer | None, toParent: Integer | None): MessageResponse
      +delete(categoryId: Integer): MessageResponse
      +search(query: CategoryQuery): CategoryResponse
      +getScript(categoryId: Integer): CategoryScript
      +updateScript(categoryId: Integer, script: CategoryScript | None): MessageResponse
    }

    CategoryController --> CategoryService : calls >
    CategoryController --> CategoryRepository : calls >

    class DistributionController {
      +create(distribution: DistributionCreate): MessageResponse
      +update(distributionId: Integer, distribution: DistributionCreate): ItemMessageResponse<Distribution>
      +delete(distributionId: Integer): MessageResponse
      +listAll(): List<Distribution>
    }

    DistributionController --> DistributionRepository : calls >

    class IntentionController {
      +create(intention: IntentionEdit): ItemMessageResponse<Intention>
      +update(intentionId: Integer, intention: IntentionEdit): ItemMessageResponse<Intention>
      +delete(intentionId: Integer): MessageResponse

      +createProject(intention: IntentionEdit): MessageResponse
      +updateProject(intentionId: Integer, intention: IntentionEdit): ItemMessageResponse<Intention>
      +deleteProject(intentionId: Integer): MessageResponse

      +acceptProject(intentionId: Integer): MessageResponse
      +declineProject(intentionId: Integer): MessageResponse
      
      +search(query: IntentionQuery): IntentionResponse
    }

    IntentionController --> IntentionEdit : uses
    IntentionController --> IntentionQuery : uses

    IntentionController --> IntentionRepository : calls >

    class DigitizationListController {
      +create(query: DocumentQuery): ItemMessageResponse<Task>
      +delete(digitizationListId: Integer): ItemMessageResponse<Task>
      +addDocuments(digitizationListId: Integer, query: DocumentQuery): ItemMessageResponse<Task>
      +removeDocuments(digitizationListId: Integer, query: DocumentQuery): ItemMessageResponse<Task>
      +search(query: DigitizationListQuery): DigitizationListResponse
    }

    DigitizationListController --> DigitizationListRepository : calls >
  }
}

@enduml