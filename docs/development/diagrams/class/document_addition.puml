@startuml VERA - Class Diagram - Documents

skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 150
' skinparam linetype ortho
top to bottom direction

!define ENTITY_REL #D3D3D3

package "Digitization Planner" {

  package "Types" {

    enum DocumentProposalStatus {
      Enqueued
      Processing
      NotEligibleForAddition
      Pending
      Accepted
      Declined
    }

    enum DocumentAdditionStatus {
      Enqueued
      Processing
      ActiveDuplicate
      FullyProcessedDuplicate
      InDigitization
      DigitizationForbidden
      AmbiguousIssues
      AllIssuesResolved
      Completed
      CatalogRecordFailure
      DigitizationRegistryFailure
      InternalFailure
    }

  }

  package "Schemas" {

    entity DocumentProposalCreate {
      +itentifierType: IdentifierType
      +identifierValue: String
      +reasonMessage: String
      +fileName: String | None
      +categoryId: Integer | None
    }

    DocumentProposalCreate -[ENTITY_REL]-> IdentifierType : contains

    entity DocumentProposal extends DocumentProposalCreate {
      +id: Integer
      +createdBy: String
      +createdAt: Timestamp
      +eligibilityStatus: DocumentAdditionStatus = DocumentAdditionStatus::Enqueued
      +status: DocumentProposalStatus
      +statusUpdatedBy: String | None
      +statusUpdatedAt: Timestamp | None
      +iterationStatus: DocumentIterationStatus | None
      +isArchived: Boolean
    }

    DocumentProposal -[ENTITY_REL]-> DocumentAdditionStatus : contains
    DocumentProposal -[ENTITY_REL]-> DocumentProposalStatus : contains

    entity DocumentAdditionCreate {
      +itentifierType: IdentifierType
      +identifierValue: String
      +fileName: String | None
      +categoryId: Integer
      +priority: Integer [1-5]
    }

    DocumentAdditionCreate -[ENTITY_REL]-> IdentifierType : contains

    entity DocumentAddition extends DocumentAdditionCreate {
      +id: Integer
      +createdBy: String
      +createdAt: Timestamp
      +fromProposal: Integer | None
      +ignoreDigitizationCheck: Boolean
      +allowNewIteration: Boolean
      +status: DocumentAdditionStatus
      +errorMessage: String | None
      +isArchived: Boolean
    }

    DocumentAddition -[ENTITY_REL]-> DocumentAdditionStatus : contains

    entity Document {
      +id: Integer
      +catalogBase: String
      +systemNumber: String
      +barcode: String | None
      +volumeNumber: String | None
      +volumeYear: String | None
      +bundle: String | None
      +issuanceType: IssuanceType
      +pageCount: Dict<String, Integer>
      +status: CatalogRecordStatus
      +iteration: Integer
      +addedAt: Timestamp = Timestamp::Now
      +addedBy: String
      +categoryId: Integer
      +priority: Integer [1-5]
      +digitizationListId: Integer | None
      +isExtractable: Boolean
      +categoryIds: List<Integer>
      +extractedBy: String | None
      +extractedAt: String | None
      +isArchived: Boolean
    }

    Document -[ENTITY_REL]-> CatalogRecordStatus : contains
  }

  package "Repositories" {

    package "Model" {

      class DocumentModel {
        +id: Integer
        +catalogBase: String
        +systemNumber: String
        +barcode: String | None
        +volumeNumber: String | None
        +volumeYear: String | None
        +bundle: String | None
        +issuanceType: IssuanceType
        +pageCount: Dict<String, Integer>
        +status: DocumentStatus
        +getPageCount(): Integer | None
        +getIterations(): List<DocumentIterationModel>
      }

      class DocumentProposalModel {
        +id: Integer
        +identifierType: IdentifierType
        +identifierValue: String
        +reasonMessage: String
        +fileName: String | None = None
        +categoryId: Integer | None = None
        +createdBy: String
        +createdAt: Timestamp = Timestamp::Now
        +additionEligibilityStatus: DocumentAdditionStatus = DocumentAdditionStatus::Enqueued
        +status: DocumentProposalStatus = DocumentProposalStatus::Pending
        +statusUpdatedBy: String | None = None
        +statusUpdatedAt: Timestamp | None = None
        +isArchived: Boolean = False
      }

      class DocumentAdditionModel {
        +id: Integer
        +identifierType: IdentifierType
        +identifierValue: String
        +createdBy: String
        +createdAt: Timestamp = Timestamp::Now
        +fileName: String | None = None
        +fromProposal: Integer | None = None
        +categoryId: Integer
        +priority: Integer [1-5] = 3
        +ignoreDigitizationCheck: Boolean = False
        +allowNewIteration: Boolean = False
        +status: DocumentAdditionStatus = DocumentAdditionStatus::Enqueued
        +errorMessage: String | None = None
        +isArchived: Boolean = False
      }

      class DocumentIterationModel {
        +id: Integer
        +documentId: Integer
        +iteration: Integer
        +addedAt: Timestamp = Timestamp::Now
        +addedBy: String
        +categoryId: Integer
        +priority: Integer [1-5]
        +digitizationListId: Integer | None
        +isExtractable(): Boolean
        +categoryName(): String
        +categoryIds(): List<Integer>
        +extractedBy(): String | None
        +extractedAt(): String | None
        +isArchived(): Boolean = False
      }
    }

    class DocumentProposalRepository {
      +get(additionId: Integer): DocumentAdditionModel
      +save(addition: DocumentAdditionModel): DocumentAdditionModel
      +delete(additionId: Integer): DocumentAdditionModel
      +index(addition: DocumentAdditionModel): DocumentAdditionModel
      +search(query: DocumentAdditionsQuery): DocumentProposalsResponse
    }

    DocumentProposalRepository -[ENTITY_REL]-> DocumentProposalModel : manages >

    class DocumentAdditionRepository {
      +get(additionId: Integer): DocumentAdditionModel
      +save(addition: DocumentAdditionModel): DocumentAdditionModel
      +delete(additionId: Integer): DocumentAdditionModel
      +index(addition: DocumentAdditionModel): DocumentAdditionModel
      +search(query: DocumentAdditionsQuery): DocumentAdditionsResponse
    }

    DocumentAdditionRepository -[ENTITY_REL]-> DocumentAdditionModel : manages >

    class DocumentRepository {
      +get(documentId: Integer): DocumentIterationModel
      +getAll(): List<DocumentIterationModel>
      +save(document: DocumentIterationModel): DocumentIterationModel
      +delete(documentId: Integer): DocumentIterationModel
      +index(document: DocumentModel): DocumentModel
      +search(DocumentQuery): DocumentsResponse
    }

    DocumentRepository -[ENTITY_REL]-> DocumentModel : manages >
    DocumentRepository -[ENTITY_REL]-> DocumentIterationModel : manages >
  }

  package "Services" {

    class AcceptProposalResult {
      +accepted: Integer
      +acceptedDeclined: Integer
      +alreadyAccepted: Integer
    }

    class DeclineProposalResult {
      +declined: Integer
      +alreadyAccepted: Integer
      +alreadyDeclined: Integer
    }

    class DocumentProposalService {
      +enqueue(additions: List<DocumentProposalCreate>): EnqueueDocumentProposalResult
      +restrictQuery(query: DocumentProposalQuery, user: User): DocumentProposalQuery
      +acceptProposal(query: DocumentProposalQuery, categoryId: Integer): AcceptProposalResult
      +declineProposal(query: DocumentProposalQuery): DeclineProposalResult
    }

    DocumentProposalService -[ENTITY_REL]-> DocumentProposalCreate : uses
    DocumentProposalService -[ENTITY_REL]-> DocumentProposalQuery : uses
    DocumentProposalService -[ENTITY_REL]-> User : uses

    DocumentProposalController o-- EnqueueDocumentProposalResult : returns >
    DocumentProposalController o-- AcceptProposalResult : returns >
    DocumentProposalController o-- DeclineProposalResult : returns >

    DocumentProposalService --> DocumentRepository : checks if document is already present >
    DocumentProposalService --> DocumentProposalRepository : uses >

    entity EnqueueDocumentAdditionResult {
      +enqueued: Integer
      +alreadyEnqueued: Integer
    }

    entity IgnoreDigitizationCheckResult {
      +numFound: Integer
      +alreadyWithFlag: Integer
      +reindexTask: Task
    }

    entity AllowNewIterationResult {
      +numFound: Integer
      +alreadyWithFlag: Integer
      +reindexTask: Task
    }

    entity DeleteDocumentAdditionResult {
      +deleted: Integer
      +alreadyDeleted: Integer
    }

    class DocumentAdditionService {
      +enqueue(additions: List<DocumentAdditionCreate>): EnqueueDocumentAdditionResult
      +restrictQuery(query: DocumentAdditionQuery, user: User): DocumentAdditionQuery
      +ignoreDigitizationCheck(query: DocumentAdditionQuery): IgnoreDigitizationCheckResult
      +allowNewIteration(query: DocumentAdditionQuery): AllowNewIterationResult
      +delete(query: DocumentAdditionQuery): DeleteDocumentAdditionResult
    }

    DocumentAdditionService -[ENTITY_REL]-> DocumentAdditionCreate : uses
    DocumentAdditionService -[ENTITY_REL]-> DocumentAdditionQuery : uses
    DocumentAdditionService -[ENTITY_REL]-> User : uses
    
    DocumentAdditionService o-- EnqueueDocumentAdditionResult : returns >
    DocumentAdditionService o-- IgnoreDigitizationCheckResult : returns >
    DocumentAdditionService o-- AllowNewIterationResult : returns >
    DocumentAdditionService o-- DeleteDocumentAdditionResult : returns >

    DocumentAdditionService --> DocumentAdditionRepository : uses >
    DocumentAdditionService --> DocumentRepository : uses >

    class DocumentAdditionTaskService {
      +processProposals(): None
      +processAdditions(): None
    }

    DocumentAdditionTaskService --> DocumentProposalRepository : uses >
    DocumentAdditionTaskService --> DocumentAdditionRepository : uses >
    DocumentAdditionTaskService --> DocumentRepository : uses >
  }

  package "API Controllers" {
    
    class DocumentProposalController {
      +create(proposals: List<DocumentProposalCreate>): MessageResponse
      +search(query: DocumentProposalQuery): DocumentProposalResponse
      +acceptProposals(query: DocumentProposalQuery, categoryId: Integer): MessageResponse
      +declineProposals(query: DocumentProposalQuery): MessageResponse
      +archive(query: DocumentProposalQuery): MessageResponse
      +delete(query: DocumentProposalQuery): MessageResponse
    }

    DocumentProposalController --> DocumentProposalService : calls >
    DocumentProposalController --> DocumentProposalRepository : calls >

    class DocumentAdditionController {
      +add(additions: List<DocumentAdditionCreate>): MessageResponse
      +search(query: DocumentAdditionQuery): DocumentAdditionResponse
      +archive(query: DocumentAdditionQuery): MessageResponse
      +delete(query: DocumentAdditionQuery): MessageResponse
    }

    DocumentAdditionController --> DocumentAdditionService : calls >
    DocumentAdditionController --> DocumentAdditionRepository : calls >
  }
}

@enduml