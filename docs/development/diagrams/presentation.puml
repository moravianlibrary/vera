@startuml VERA Presentation

skinparam backgroundColor #F0F0F0
skinparam classAttributeIconSize 0
skinparam classBorderColor #0066CC
skinparam classBackgroundColor #E6F2FF
skinparam classFontColor #003366

entity "Catalog Record Adapter" as CatalogAdapter {
  +fetch(base: str, system_number: str) : MarcRecord | None
  +get_query_schema() : Dict[str, Any] 
  +search(query: Dict[str, Any], page: int, page_size: int) : SearchResultResponse
  +fetch_changes(last_sync: datetime | None) : Generator[ListRecordResponse, None, None]
}

entity "Digitization Registry Adapter" as DigitizationAdapter {
  +fetch(registry_issue_id: str) : DigitizationRecord | None
  +find_for_marc_record(marc_record: MarcRecord) : DigitizationRecord | None
  +find_for_marc_issue(record: MarcRecord, issue: MarcIssue) : DigitizationRecord | None
  +change_state(record_id: str, issue_id: str, state: DigitizationRecordState) : None
}

entity "Document Property Adapter" as DocumentAdapter {
  +save_property(record_id: str, property_name: str, value: Any) : None
  +fetch_property(record_id: str, property_name: str) : Any | None
  +search_property(query: Dict[str, Any]) : List[Dict[str, Any]]
}

entity "Category Script Plugin" as CategoryScriptPlugin {
  +populate_categories(data: Any) : None
  +get_categories() : List[str]
  +map_category_to_record(record_id: str, category: str) : None
}

"VERA App" --> CatalogAdapter : Communicates with
"VERA App" --> DigitizationAdapter : Communicates with
"VERA App" --> DocumentAdapter : Communicates with
"VERA App" --> CategoryScriptPlugin : Uses

note right of "VERA App" : The main functionality remains constant.\nAdapters are pluggable via interfaces.

@enduml
