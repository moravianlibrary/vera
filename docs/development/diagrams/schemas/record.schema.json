{
    "description": "MARC-in-JSON Schema",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "leader": {
                "type": "string",
                "minLength": 24,
                "maxLength": 24
            },
            "fields": {
                "type": "array",
                "items": {
                    "type": "object",
                    "anyOf": [
                        {
                            "type": "object",
                            "patternProperties": {
                                "^[0-9A-Z]{3}$": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        },
                        {
                            "type": "object",
                            "properties": {
                                "ind1": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1
                                },
                                "ind2": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1
                                },
                                "subfields": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "patternProperties": {
                                            "^[a-zA-Z0-9]$": {
                                                "type": "string"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "additionalProperties": false
                        }
                    ]
                }
            }
        },
        "required": [
            "leader",
            "fields"
        ],
        "additionalProperties": false
    }
}