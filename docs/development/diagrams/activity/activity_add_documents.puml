@startuml VERA - Add Documents Activity Diagram

|#pink|User|
start

:Take one DocumentAddition entity from queue;

:Find identifier in catalog records database;

if (Is document identifier found?) then (yes)
    if (Catalog record from database is too old?) then (yes)
        :Synchronize catalog record with catalog;
        if (Catalog record found in catalog?) then (yes)
            :Update catalog record;
        else (no)
            :Mark catalog record as Unreachable;
            :Update state of DocumentAddition to CatalogRecordUnreachable;
            stop
        endif
    else (no)
    endif
    :Retrieve catalog record from database;
else (no)
    :Find identifier in catalog;
    if (Is document identifier found?) then (yes)
        :Retrieve catalog record;
        :Save catalog record;
        :Save catalog record comparison;
        :Save all parseable identifiers;
    else (no)
        :Update state of DocumentAddition to CatalogRecordNotFound;
        stop
    endif
endif

:Parse unit information based on identifier;
if (Is this unit already present in VERA?) then (yes)
    if (Should add document again?) then (yes)
        if (Are all previous instances of this document already processed?) then (yes)
        else (no)
            :Update state of DocumentAddition to UnprocessedInstanceAlreadyPresent;
            stop
        endif
    else (no)
        :Update state of DocumentAddition to AlreadyPresent;
        stop
    endif
else (no)
endif

:Get digitalization state;
if (Is digitization state NotDigitized?) then (yes)
    :Add document to VERA;
    :Update state of DocumentAddition to NewlyAdded;
else (no)
    if (Should ignore digitalization state?) then (yes)
        :Add document to VERA;
        :Update state of DocumentAddition to NewlyAdded;
        :Set DocumentAddition flag IgnoredDigitizationState;
    else (no)
        :Update state of DocumentAddition based on digitalization state;
        stop
    endif
endif

stop

@enduml
