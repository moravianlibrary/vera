@startuml
skinparam classAttributeIconSize 0

package "Connectors" {

  package "Catalog" {
    enum CatalogFetchStatus {
      CatalogUnavailable
      CatalogRequestFailed
      RecordNotFound
      UnrecognizedBase
      InvalidSystemNumber
      Success
    }

    class CatalogGetResponse {
      record: Record | None
      status: CatalogFetchStatus
    }

    class CatalogSearchItem {
      base: String
      systemNumber: String
      record: Record
    }

    class CatalogSearchResponse {
      items: List<CatalogSearchItem> | None
      numFound: Integer
      status: CatalogFetchStatus
    }

    interface CatalogConnector {
      +getRecord(base: String, systemNumber: String): CatalogGetResponse
      +search(
        value: String,
        base: String | None,
        field: String | None,
        page: Integer,
        pageSize: Integer
      ): CatalogSearchResponse
    }

    class CatalogDispatcher {
      +loadConfig(config: CatalogConnectorConfig): None
      +getRecord(base: String, systemNumber: String): CatalogGetResponse
      +search(
        value: String,
        base: String | None,
        field: String | None,
        page: Integer,
        pageSize: Integer
      ): CatalogSearchResponse
    }
  }

  package "Digitization Registry" {
    enum DRFetchStatus {
      Unavailable
      RequestFailed
      Success
    }

    enum DRState {
      Finished
      InProgress
      Planned
      NotDigitized
      Revision
      Unknown
    }

    class DRConnectorResponse {
      source: String | None
      id: Integer | None
      state: DRState | None
      status: FetchStatus
    }

    interface DRConnector {
      +getRecord(recordId: String): DRConnectorResponse
      +search(record: Record, issue: Issue): DRConnectorResponse
    }

    class RDczConnector implements DRConnector {
    }

    class DRKrameriusConnector implements DRConnector {
    }

    class DRDispatcher {
      +loadConfig(config: DRConnectorConfig): None
      +getRecord(recordId: String): List<DRConnectorResponse>
      +search(record: Record, issue: Issue): List<DRConnectorResponse>
    }
  }
}

package "Digitization Planner" {

  package "Schemas" {
    class MessageResponse {
      status: StatusCode,
      message: String
    }

    class UpdateMessageResponse<T> extends MessageResponse {
      item: T | None
    }

    class DocumentAddition {
      identifierType: IdentifierType
      identifierValue: String
      fileName: String | None
      categoryId: Integer | None
      priority: Integer [1-5] | None
      ignoreDigitizationState: Boolean | None
      addAgainIfPresent: Boolean | None
    }

    class ProcessedDocumentAddition extends DocumentAddition {
      identifierType: IdentifierType
      identifierValue: String
      owner: String
      record: Record | None
      status: DocumentAdditionStatus
    }
  }

  package "API Controllers" {
    class DocumentAdditionsController {
      +add(additions: List<DocumentAddition>): MessageResponse
      +search(query: DocumentAdditionQuery): DocumentAdditionResponse
      +delete(query: DocumentAdditionQuery): MessageResponse
      +acceptProposal(query: DocumentAdditionQuery, categoryId: Integer): MessageResponse
      +declineProposal(query: DocumentAdditionQuery): MessageResponse
    }

    class DocumentsController {
      +search(DocumentQuery): DocumentResponse
      +export(DocumentQuery): DocumentFile
      +runTask(DocumentQuery, DocumentTask): MessageResponse
    }

    class CatalogRecordsController {
      +search(query: CatalogRecordQuery): CatalogRecordResponse
      +runTask(query: CatalogRecordQuery, CatalogRecordTask): MessageResponse
      +approveDifference(differenceId: Integer): MessageResponse<CatalogRecord>
      +rescindDifference(differenceId: Integer): MessageResponse<CatalogRecord>
      +createList(list: CatalogRecordListEdit): MessageResponse<CatalogRecordList>
      +updateList(listId: Integer, list: CatalogRecordListEdit): MessageResponse<CatalogRecordList>
      +deleteList(listId: Integer): MessageResponse
      +searchLists(query: CatalogRecordListQuery): CatalogRecordListResponse
    }

    class CategoriesController {
      +create(category: CategoryEdit): MessageResponse
      +update(categoryId: Integer, category: CategoryEdit): MessageResponse<Category>
      +changeParent(
        categoryId: Integer,
        fromParent: Integer | None,
        toParent: Integer | None
      ): MessageResponse
      +delete(categoryId: Integer): MessageResponse
      +search(query: CategoryQuery): CategoryResponse
      +getScript(categoryId: Integer): MessageResponse<Script>
      +updateScript(categoryId: Integer, script: Script | None): MessageResponse
    }

    class IntentionsController {
      +create(intention: IntentionEdit): MessageResponse
      +update(intentionId: Integer, intention: IntentionEdit): MessageResponse<Intention>
      +delete(intentionId: Integer): MessageResponse
      +search(query: IntentionQuery): IntentionResponse
      +accept(intentionId: Integer): MessageResponse
      +decline(intentionId: Integer): MessageResponse
    }

    class DigitizationListsController {
      +create(query: DocumentQuery): MessageResponse
      +delete(digitizationListId: Integer): MessageResponse
      +addDocuments(digitizationListId: Integer, query: DocumentQuery): MessageResponse
      +removeDocuments(digitizationListId: Integer, query: DocumentQuery): MesageResponse
      +search(query: DigitizationListQuery): DigitizationListResponse
    }

    class UserController {
      +getNotifications(): UserNotifications
      +getSettings(): UserSettings
      +saveSettings(UserSettings): MessageResponse
    }

    class SystemController {
      +testEntityProperty(EntityProperty):
      +createEntityProperty(EntityProperty):
      +updateEntityProperty(EntityPropertyId):
      +deleteEntityProperty(Entity, EntityPropertyId):
      +searchEntityProperties()
      +runTask(SystemTask): Message
      +listBackups()
      +downloadBackup()
    }
  }

  package "Security" {
    class Permission {}

    class OwnershipPermission {}
  }

  package "Services" {
    class DocumentAdditionService {
      +enqueue(additions: List<DocumentAddition>): None
      +restrictQuery(query: DocumentAdditionQuery, user: User): DocumentAdditionQuery
      +delete(query: DocumentAdditionQuery): MessageResponse
      +acceptProposal(query: DocumentAdditionQuery, categoryId: Integer): MessageResponse
      +declineProposal(query: DocumentAdditionQuery): MessageResponse
      +processAdditions()
    }

    class DocumentsService {
      +restrictQuery(query: DocumentQuery, user: User): DocumentQuery
      +generateExport(query: DocumentQuery): pd.Dataframe
      +planTask(query: DocumentQuery, DocumentTask): MessageResponse

      +updateProperty(DocumentsQuery): Message
      +delete(DocumentsQuery): Message
      +declineDigitization(DocumentsQuery): Message
      +cancelDigitizationDeclination(DocumentsQuery): Message
      +generateList(adhereToCategories: Boolean):
    }
  }

  package "Types" {
    enum IdentifierType {
      Barcode
      SystemNumber
      ISXN
      Signature
    }

    enum DocumentsTask {
      UpdateProperty
      Remove
      Reindex
      SyncDigitizationState
      SyncCatalogRecord
      PredictPageCount
      DeclineDigitization
      CancelDigitizationDeclination
      GenerateDigitizationList
    }

    enum CatalogRecordsTask {
      ApproveDifferences
      RescindDifferences
      IgnoreMissingAuthority
      Reindex
      Sync
      ReevaluateDifferences
    }

    enum SystemTask {
      RecreateIndexes
      GenerateBackup
      LoadFromBackup
      FindAndRepairInconsistencies
    }

    enum CategoriesTask {
      AddDocumentsUsingScript
    }
  }

  package "Repositories" {

    package "Model" {
      class DocumentAddition {
        +identifierType: Enum<IdentifierType>
        +identifierValue: String
        +owner: String
        +filename: String | None = None
        +category: Integer
        +priority: Integer [1-5] = 3
        +ignoreDigitizationState: Boolean = False
        +addAgainIfPresent: Boolean = False
      }

      class CatalogRecord {
        +id: String
        +base: String
        +systemNumber: String
        +marc: Binary
        +unreachable: Boolean = False
        +addedAt: Timestamp
        +updatedAt: Timestamp
        +hasAddedDocuments(): Boolean
        +hasActiveDocuments(): Boolean
        +isValid(): Boolean
        +authoritiesRecordIds(): List<String>
        +authoritiesMarc(): List<Marc>
        +authoritiesDifference(): List<MarcDifference>
        +authoritiesDifferenceFlags(): List<DifferenceFlag>
      }

      class CatalogRecordAuthority {
        +mainId: String
        +authorityBase: String
        +isValid: Boolean = True
        +hasDifferences: Boolean = False
        +authorityId: String | None = None
      }

      class CatalogRecordDifference {
        +id: Integer
        +mainId: String
        +authorityId: String
      }

      class Document {
        +id: Integer
        +recordId: String
        +barcode: String | None
        +volume: String | None
        +volume_year: String | None
        +bundle: String | None
        +iteration: Integer | None
        +issuanceType: Enum<IssuanceType>
        +added_at: Timestamp = now
        +added_by: String
        +categoryId: Integer
        +pageCountCatalog: Integer | None
        +pageCountPredicted: Integer | None
        +pageCountManual: Integer | None
        +priority: Integer [1-5]
        +digitizationListId: Integer | None
        +pageCount(): Integer | None
        +isExtractable(): Boolean
        +categoryName(): String
        +categoryIds(): List<Integer>
        +extractedBy(): String | None
        +extractedAt(): String | None
      }

      class ParsingScript {
      }

      class Category {
        +id: Integer
        +name: String
        +descripton: String | None
        +parentId: Integer | None = None
        +level: Integer = 0
        +assignable: Boolean = False
        +extractWhole: Boolean = False
        +disabled: Boolean = False
        +archived: Boolean = False
        +sourceTask: BashScriptFile | None = None
        +directlyAssignedTo: List<GroupName> | List<UserName> | None = None
        +assignedTo(): List<GroupName> | List<UserName> | None = None
        +totalPageCount(): Integer
        +totalDocuments(): Integer
        +extractablePageCount(): Integer
        +extractableDocuments(): Integer
        +extractedPageCount(): Integer
        +extractedDocuments(): Integer
      }

      class Connector {
        +name: String
                
      }

      class EntityProperty {
        +id: Integer
        +entity: 
        +name: String
        +translations: JSON
        +parseScript: ParseScript
      }

      class CategoriesDistribution {
        +id: Integer
        +name: String
        +active: Boolean
      }

      class CategoryDistribution {
        +categoryId: Integer
        +distributionId: Integer
        +percentage: Float
      }
    }

    class DocumentAdditionRepository {
      +get():
      +save():
      +index():
      +search(DocumentAdditionsQuery): DocumentAdditionsResponse
    }

    class DocumentRepository {
      +get():
      +save():
      +index():
      +search(DocumentQuery): DocumentsResponse
    }

    class CatalogRecordsRepository {
      +get():
      +save():
      +index():
      +search(CatalogRecordsQuery): CatalogRecordsResponse
    }

    class CategoriesRepository {
      +get():
      +save():
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }
  }

  "API Controllers" --> "Security": Enforces permissions
}

package "Digitization Registry" {
  class Controller {
    +getRecord(DocumentId, DocumentIdentifiers): List[State, Source]
    +updateState(DocumentId, State): void
  }
}

package "MARC Comparator" {
  class Controller {
    +compare(Record, Record): List[MARCDifferences]
    +loadFromArchive(ArchiveFile, MappingFile): void
  }

  class Service {
    +compare(Record, Record): List[MARCDifferences]
    +loadFromArchive(ArchiveFile, MappingFile): void
  }

  class Repository {
    +saveArchive(ArchiveFile): void
    +saveMapping(MappingFile): void
    +saveComparison(): void
    +loadComparison(): void
  }

  Controller --> Service : Uses
  Service --> Repository : Uses
}

' Dependencies

CatalogRecordsDatabase --> CatalogConnector : Fetches records
CatalogRecordsDatabase --> MARCComparator : Compares records
CatalogConnector --> Aleph_Z39_50 : Uses
CatalogConnector --> Aleph_X_API : Uses
CatalogConnector --> Aleph_OAI_API : Uses

DigitizationRegistry --> RDConnector : Reads from
DigitizationRegistry --> KrameriusConnector : Reads from

@enduml
