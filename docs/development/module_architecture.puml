@startuml
skinparam classAttributeIconSize 0
skinparam ranksep 150
skinparam nodesep 10
skinparam linetype ortho
top to bottom direction

package "Digitization Planner" {

  package "Schemas" {
    entity MessageResponse {
      status: StatusCode,
      message: String
    }

    entity ItemMessageResponse<T> extends MessageResponse {
      item: T | None
    }

    entity DocumentAddition {
      identifierType: IdentifierType
      identifierValue: String
      fileName: String | None
      categoryId: Integer | None
      priority: Integer [1-5] | None
      ignoreDigitizationState: Boolean | None
      addAgainIfPresent: Boolean | None
    }

    DocumentAddition --> IdentifierType : uses >

    entity ProcessedDocumentAddition extends DocumentAddition {
      owner: String
      record: Record | None
      status: DocumentAdditionStatus
    }

    entity Task {
    }

    entity TaskPeriod {
    }

    entity PeriodicTask {
    }

    entity ElasticsearchQuery {}

    entity ElasticsearchResponse {}

    entity TaskQuery {}

    entity TaskResponse {}

    entity TaskItemQuery {}

    entity TaskItemResponse {}

    entity PeriodicTaskQuery {}

    entity PeriodicTaskResponse {}

    entity DocumentQuery extends ElasticsearchQuery {}

    entity DocumentResponse extends ElasticsearchResponse {}

    entity CategoryEdit {}

    entity Category extends CategoryEdit {}

    entity Script {}

    entity CategoryQuery extends ElasticsearchQuery {}

    entity CategoryResponse extends ElasticsearchResponse {}

    entity IntentionEdit {}

    entity Intention extends IntentionEdit {}

    entity IntentionQuery extends ElasticsearchQuery {}

    entity IntentionResponse extends ElasticsearchResponse {}

    entity IntentionQuery extends ElasticsearchQuery {}

    entity IntentionResponse extends ElasticsearchResponse {}

    entity DigitizationListQuery extends ElasticsearchQuery {}

    entity DigitizationListResponse extends ElasticsearchResponse {}
  }

  package "Repositories" {

    package "Model" {
      class DocumentAdditionModel {
        +id: Integer
        +identifierType: Enum<IdentifierType>
        +identifierValue: String
        +owner: String
        +filename: String | None = None
        +category: Integer
        +priority: Integer [1-5] = 3
        +ignoreDigitizationState: Boolean = False
        +addAgainIfPresent: Boolean = False
      }


      class DocumentModel {
        +id: Integer
        +recordId: String
        +barcode: String | None
        +volume: String | None
        +volume_year: String | None
        +bundle: String | None
        +iteration: Integer | None
        +issuanceType: Enum<IssuanceType>
        +added_at: Timestamp = now
        +added_by: String
        +categoryId: Integer
        +pageCountCatalog: Integer | None
        +pageCountPredicted: Integer | None
        +pageCountManual: Integer | None
        +priority: Integer [1-5]
        +digitizationListId: Integer | None
        +pageCount(): Integer | None
        +isExtractable(): Boolean
        +categoryName(): String
        +categoryIds(): List<Integer>
        +extractedBy(): String | None
        +extractedAt(): String | None
      }

      class CategoryModel {
        +id: Integer
        +name: String
        +descripton: String | None
        +parentId: Integer | None = None
        +level: Integer = 0
        +assignable: Boolean = False
        +extractWhole: Boolean = False
        +disabled: Boolean = False
        +archived: Boolean = False
        +sourceTask: BashScriptFile | None = None
        +directlyAssignedTo: List<GroupName> | List<UserName> | None = None
        +assignedTo(): List<GroupName> | List<UserName> | None = None
        +totalPageCount(): Integer
        +totalDocuments(): Integer
        +extractablePageCount(): Integer
        +extractableDocuments(): Integer
        +extractedPageCount(): Integer
        +extractedDocuments(): Integer
      }

      class Connector {
        +name: String
                
      }


      class CategoriesDistributionModel {
        +id: Integer
        +name: String
        +active: Boolean
      }

      class CategoryDistribution {
        +categoryId: Integer
        +distributionId: Integer
        +percentage: Float
      }
    }

    class DocumentAdditionRepository {
      +get(additionId: Integer): DocumentAdditionModel
      +save(addition: DocumentAdditionModel): DocumentAdditionModel
      +delete(additionId: Integer): DocumentAdditionModel
      +index(addition: DocumentAdditionModel): DocumentAdditionModel
      +search(DocumentAdditionsQuery): DocumentAdditionsResponse
    }

    DocumentAdditionRepository --> DocumentAdditionModel : uses >
    DocumentAdditionRepository --> DocumentAddition : uses >
    DocumentAdditionRepository --> DocumentAddition : uses >

    class DocumentRepository {
      +get(documentId: Integer): DocumentModel
      +getAll(): List<DocumentModel>
      +save(document: DocumentModel): DocumentModel
      +delete(additionId: Integer): DocumentAdditionModel
      +index(document: DocumentModel): Document
      +search(DocumentQuery): DocumentsResponse
    }

    class CatalogRecordRepository {
      +get(catalogRecordId: String): CatalogRecordModel
      +save(catalogRecord: CatalogRecordModel): CatalogRecordModel
      +delete(catalogRecordId: String): CatalogRecordModel
      +index(catalogRecord: CatalogRecordModel): CatalogRecord
      +search(CatalogRecordsQuery): CatalogRecordsResponse
    }

    class CategoryRepository {
      +get(categoryId: Integer): CategoryModel
      +save(category: CategoryModel): CategoryModel
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }

    class IntentionRepository {
      +get():
      +save():
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }

    class DigitizationListRepository {
      +get():
      +save():
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }

    class TaskRepository {
      +get():
      +save():
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }
  }

  package "Services" {

    class EnqueueDocumentAdditionResult {
      +enqueued: Integer
      +alreadyEnqueued: Integer
    }

    class DeleteDocumentAdditionResult {
      +deleted: Integer
      +alreadyDeleted: Integer
    }

    class AcceptProposalResult {
      +accepted: Integer
      +acceptedDeclined: Integer
      +alreadyAccepted: Integer
    }

    class DeclineProposalResult {
      +declined: Integer
      +alreadyAccepted: Integer
      +alreadyDeclined: Integer
    }

    class DocumentAdditionService {
      +enqueue(additions: List<DocumentAddition>): EnqueueDocumentAdditionResult
      +restrictQuery(query: DocumentAdditionQuery, user: User): DocumentAdditionQuery
      +delete(query: DocumentAdditionQuery): DeleteDocumentAdditionResult
      +acceptProposal(query: DocumentAdditionQuery, categoryId: Integer): AcceptProposalResult
      +declineProposal(query: DocumentAdditionQuery): DeclineProposalResult
    }

    DocumentAdditionService --> DocumentAddition : uses >
    DocumentAdditionService --> DocumentAdditionQuery : uses >
    
    DocumentAdditionController o-- EnqueueDocumentAdditionResult : returns >
    DocumentAdditionController o-- DeleteDocumentAdditionResult : returns >
    DocumentAdditionController o-- AcceptProposalResult : returns >
    DocumentAdditionController o-- DeclineProposalResult : returns >

    DocumentAdditionService --> DocumentRepository : uses >

    class DocumentAdditionTaskService {
      +processAdditions(): None
    }


    DocumentService --> DocumentQuery : uses >
    DocumentService --> User : uses >
    DocumentService --> DocumentListGenerationSettings : uses >
    DocumentService --> DocumentTask : uses >

    DocumentService o-- Task : returns >

    DocumentService --> DocumentRepository : uses >

    class DocumentTaskService {
      +updateProperty(task: Task): None
      +remove(task: Task): None
      +declineDigitization(task: Task): None
      +cancelDigitizationDeclination(task: Task): None
      +generateList(task: Task): None
      +reindex(task: Task): None
      +syncDigitizationState(task: Task): None
      +predictPageCount(task: Task): None
    }

    DocumentService --> Task : uses >

    DocumentTaskService --> DocumentRepository : uses >

    class CatalogRecordService {
      +runTask(query: CatalogRecordQuery, taskType: CatalogRecordTask): Task
    }

    class CatalogRecordTaskService {
      +ignoreMissingAuthority(task: Task): None
      +reindex(task: Task): None
      +sync(task: Task): None
      +reevaluateDifferences(task: Task): None
    }

    class CategoryService {
      +updateScript(categoryId: Integer, script: Script | None): None
    }

    class CategoryTaskService {
      +addDocumentsUsingScript(task: Task): None
    }

    class UserService {
      +getNotifications(): UserNotifications
    }

    class SystemService {
      +testEntityProperty(EntityProperty):
      +createEntityProperty(EntityProperty):
      +updateEntityProperty(EntityPropertyId):
      +deleteEntityProperty(Entity, EntityPropertyId):
      +getEntityProperties(query: EntityProp)
    }

    class SystemTask {
      +recreateIndexes(): Task
      +generateBackup(filename: String): Task
      +loadFromBackup(file: BinFile): Task
    }

    class WorkerService {
      +runTask(taskId: Integer): None
      +runPeriodicTask(periodicTaskId: Integer): None
    }
  }

  package "API Controllers" {
    class DocumentAdditionController {
      +add(additions: List<DocumentAddition>): MessageResponse
      +search(query: DocumentAdditionQuery): DocumentAdditionResponse
      +delete(query: DocumentAdditionQuery): MessageResponse
      +acceptProposal(query: DocumentAdditionQuery, categoryId: Integer): MessageResponse
      +declineProposal(query: DocumentAdditionQuery): MessageResponse
    }

    DocumentAdditionController --> DocumentAddition : uses >

    DocumentAdditionController o-- ProcessedDocumentAddition : returns >
    DocumentAdditionController o-- MessageResponse : returns >

    DocumentAdditionController --> DocumentAdditionService : calls >
    DocumentAdditionController --> DocumentAdditionTaskService : runs task >

    class CatalogRecordController {
      +search(query: CatalogRecordQuery): CatalogRecordResponse
      +runTask(query: CatalogRecordQuery, taskType: CatalogRecordTask): Task
      +planPeriodicTask(
        query: CatalogRecordQuery,
        taskType: CatalogRecordTask,
        period: TaskPeriod,
        name: String
      ): PeriodicTask
      +updatePeriodicTaskQuery(query: DocumentQuery, periodicTaskId: Integer): PeriodicTask

      +approveDifference(differenceId: Integer): ItemMessageResponse<CatalogRecord>
      +rescindDifference(differenceId: Integer): ItemMessageResponse<CatalogRecord>

    }

    CatalogRecordController --> CatalogRecordQuery : uses >
    CatalogRecordController --> CatalogRecordTask : uses >
    CatalogRecordController --> TaskPeriod : uses >
    CatalogRecordController --> CatalogRecordListEdit : uses >

    CatalogRecordController o-- CatalogRecordResponse : returns >
    CatalogRecordController o-- Task : returns >
    CatalogRecordController o-- PeriodicTask : returns >
    CatalogRecordController o-- ItemMessageResponse : returns >
    CatalogRecordController o-- CatalogRecord : returns >
    CatalogRecordController o-- CatalogRecordList : returns >

    CatalogRecordController --> CatalogRecordRepository : calls >
    CatalogRecordController --> CatalogRecordService : calls >
    CatalogRecordController --> WorkerService : starts tasks >

    class CategoryController {
      +create(category: CategoryEdit): MessageResponse
      +update(categoryId: Integer, category: CategoryEdit): ItemMessageResponse<Category>
      +changeParent(
        categoryId: Integer,
        fromParent: Integer | None,
        toParent: Integer | None
      ): MessageResponse
      +delete(categoryId: Integer): MessageResponse
      +search(query: CategoryQuery): CategoryResponse
      +getScript(categoryId: Integer): ItemMessageResponse<Script>
      +updateScript(categoryId: Integer, script: Script | None): MessageResponse
    }

    CategoryController --> CategoryEdit : uses >
    CategoryController --> CategoryQuery : uses >
    CategoryController --> Script : uses >

    CategoryController o-- MessageResponse : returns >
    CategoryController o-- ItemMessageResponse : returns >
    CategoryController o-- Category : returns >
    CategoryController o-- CategoryResponse : returns >
    CategoryController o-- Script : returns >

    CategoryController --> CategoryRepository : calls >
    CategoryController --> CategoryService : calls >
    CategoryController --> WorkerService : starts tasks >

    class IntentionController {
      +create(intention: IntentionEdit): MessageResponse
      +update(intentionId: Integer, intention: IntentionEdit): ItemMessageResponse<Intention>
      +delete(intentionId: Integer): MessageResponse

      +createProject(intention: IntentionEdit): MessageResponse
      +updateProject(intentionId: Integer, intention: IntentionEdit): ItemMessageResponse<Intention>
      +deleteProject(intentionId: Integer): MessageResponse

      +acceptProject(intentionId: Integer): MessageResponse
      +declineProject(intentionId: Integer): MessageResponse
      
      +search(query: IntentionQuery): IntentionResponse
    }

    IntentionController --> IntentionEdit : uses >
    IntentionController --> IntentionQuery : uses >

    IntentionController o-- MessageResponse : returns >
    IntentionController o-- ItemMessageResponse : returns >
    IntentionController o-- Intention : returns >
    IntentionController o-- IntentionResponse : returns >

    IntentionController --> IntentionRepository : calls >

    class DigitizationListController {
      +create(query: DocumentQuery): ItemMessageResponse<Task>
      +delete(digitizationListId: Integer): ItemMessageResponse<Task>
      +addDocuments(digitizationListId: Integer, query: DocumentQuery): ItemMessageResponse<Task>
      +removeDocuments(digitizationListId: Integer, query: DocumentQuery): ItemMessageResponse<Task>
      +search(query: DigitizationListQuery): DigitizationListResponse
    }

    DigitizationListController --> DocumentQuery : uses >
    DigitizationListController --> DigitizationListQuery : uses >

    DigitizationListController o-- ItemMessageResponse : returns >
    DigitizationListController o-- Task : returns >
    DigitizationListController o-- DigitizationListResponse : returns >

    DigitizationListController --> DigitizationListRepository : calls >

    class TaskController {
      +searchTasks(query: TaskQuery): TaskResponse
      +searchTaskItems(query: TaskItemQuery): TaskItemResponse
      +searchPeriodicTasks(query: PeriodicTaskQuery): PeriodicTaskResponse
      +updatePeriodicTask(periodicTaskId: Integer, name: String, period: TaskPeriod): ItemMessageResponse<PeriodicTask>
      +deletePeriodicTask(periodicTaskId: Integer): MessageResponse
    }

    TaskController --> TaskQuery : uses >
    TaskController --> TaskItemQuery : uses >
    TaskController --> PeriodicTaskQuery : uses >
    TaskController --> TaskPeriod : uses >

    TaskController o-- TaskResponse : returns >
    TaskController o-- TaskItemResponse : returns >
    TaskController o-- PeriodicTaskResponse : returns >
    TaskController o-- ItemMessageResponse : returns >
    TaskController o-- PeriodicTask : returns >
    TaskController o-- MessageResponse : returns >

    TaskController -d-> TaskRepository : calls >

    class UserController {
      +getNotifications(): UserNotifications
      +getSettings(): UserSettings
      +saveSettings(settings: UserSettings): MessageResponse
    }

    class SystemController {
    }
  }

  package "Security" {
    class Permission {}

    class OwnershipPermission {}
  }

  "API Controllers" --> "Security": Enforces permissions
}

package "Digitization Registry" {
  class Controller {
    +getRecord(DocumentId, DocumentIdentifiers): List[State, Source]
    +updateState(DocumentId, State): void
  }
}

package "MARC Comparator" {
  class Controller {
    +compare(Record, Record): List[MARCDifferences]
    +loadFromArchive(ArchiveFile, MappingFile): void
  }

  class Service {
    +compare(Record, Record): List[MARCDifferences]
    +loadFromArchive(ArchiveFile, MappingFile): void
  }

  class Repository {
    +saveArchive(ArchiveFile): void
    +saveMapping(MappingFile): void
    +saveComparison(): void
    +loadComparison(): void
  }

  Controller --> Service : Uses
  Service --> Repository : Uses
}

' hide class "Digitization Planner"::"CatalogRecordController"
@enduml