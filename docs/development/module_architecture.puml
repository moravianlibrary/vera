@startuml VERA - Package Class Diagram

skinparam classAttributeIconSize 0

package "Connectors" {

  package "Catalog" {
    enum CatalogFetchStatus {
      CatalogUnavailable
      CatalogRequestFailed
      RecordNotFound
      UnrecognizedBase
      InvalidSystemNumber
      Success
    }

    class CatalogGetResponse {
      record: Record | None
      status: CatalogFetchStatus
    }

    class CatalogSearchItem {
      base: String
      systemNumber: String
      record: Record
    }

    class CatalogSearchResponse {
      items: List<CatalogSearchItem> | None
      numFound: Integer
      status: CatalogFetchStatus
    }

    interface CatalogConnector {
      +getRecord(base: String, systemNumber: String): CatalogGetResponse
      +search(
        value: String,
        base: String | None,
        field: String | None,
        page: Integer,
        pageSize: Integer
      ): CatalogSearchResponse
    }

    class CatalogDispatcher {
      +loadConfig(config: CatalogConnectorConfig): None
      +getRecord(base: String, systemNumber: String): CatalogGetResponse
      +search(
        value: String,
        base: String | None,
        field: String | None,
        page: Integer,
        pageSize: Integer
      ): CatalogSearchResponse
    }
  }

  package "Digitization Registry" {
    enum DRFetchStatus {
      Unavailable
      RequestFailed
      Success
    }

    enum DRState {
      Finished
      InProgress
      Planned
      NotDigitized
      Revision
      Unknown
    }

    class DRConnectorResponse {
      source: String | None
      id: Integer | None
      state: DRState | None
      status: DRFetchStatus
    }

    interface DRConnector {
      +getRecord(recordId: String): DRConnectorResponse
      +search(record: Record, issue: Issue): DRConnectorResponse
    }

    class RDczConnector implements DRConnector {
    }

    class DRKrameriusConnector implements DRConnector {
    }

    class DRDispatcher {
      +loadConfig(config: DRConnectorConfig): None
      +getRecord(recordId: String): List<DRConnectorResponse>
      +search(record: Record, issue: Issue): List<DRConnectorResponse>
    }
  }
}

package "Digitization Planner" {

  package "Schemas" {
    class MessageResponse {
      status: StatusCode,
      message: String
    }

    class ItemMessageResponse<T> extends MessageResponse {
      item: T | None
    }

    class DocumentAddition {
      identifierType: IdentifierType
      identifierValue: String
      fileName: String | None
      categoryId: Integer | None
      priority: Integer [1-5] | None
      ignoreDigitizationState: Boolean | None
      addAgainIfPresent: Boolean | None
    }

    class ProcessedDocumentAddition extends DocumentAddition {
      owner: String
      record: Record | None
      status: DocumentAdditionStatus
    }

    class GenerateDocumentListSettings {
      +targetPageCount: Integer | None
      +targetPageCountThreshold: Float | None
      +useCategoryDistributions: Boolean | None
      +wholeCategoryThreshold: Float | None
    }
  }

  package "API Controllers" {
    class DocumentAdditionController {
      +add(additions: List<DocumentAddition>): MessageResponse
      +search(query: DocumentAdditionQuery): DocumentAdditionResponse
      +delete(query: DocumentAdditionQuery): MessageResponse
      +acceptProposal(query: DocumentAdditionQuery, categoryId: Integer): MessageResponse
      +declineProposal(query: DocumentAdditionQuery): MessageResponse
    }

    class DocumentController {
      +search(query: DocumentQuery): DocumentResponse
      +export(query: DocumentQuery): CsvFile | TxtFile
      +updateProperty(query: DocumentQuery, propertyName: String, propertyValue: String): Task
      +generateList(query: DocumentQuery, settings: GenerateDocumentListSettings): Task
      +runTask(query: DocumentQuery, taskType: DocumentTask): Task
      +planPeriodicTask(
        query: DocumentQuery,
        taskType: DocumentTask,
        period: TaskPeriod,
        name: String
      ): PeriodicTask
      +updatePeriodicTaskQuery(query: CatalogRecordQuery, periodicTaskId: Integer): PeriodicTask
    }

    class CatalogRecordController {
      +search(query: CatalogRecordQuery): CatalogRecordResponse
      +runTask(query: CatalogRecordQuery, taskType: CatalogRecordTask): Task
      +planPeriodicTask(
        query: CatalogRecordQuery,
        taskType: CatalogRecordTask,
        period: TaskPeriod,
        name: String
      ): PeriodicTask
      +updatePeriodicTaskQuery(query: DocumentQuery, periodicTaskId: Integer): PeriodicTask

      +approveDifference(differenceId: Integer): MessageResponse<CatalogRecord>
      +rescindDifference(differenceId: Integer): MessageResponse<CatalogRecord>

      +createList(list: CatalogRecordListEdit): MessageResponse<CatalogRecordList>
      +updateList(listId: Integer, list: CatalogRecordListEdit): MessageResponse<CatalogRecordList>
      +deleteList(listId: Integer): MessageResponse
      +searchLists(query: CatalogRecordListQuery): CatalogRecordListResponse
    }

    class CategoryController {
      +create(category: CategoryEdit): MessageResponse
      +update(categoryId: Integer, category: CategoryEdit): MessageResponse<Category>
      +changeParent(
        categoryId: Integer,
        fromParent: Integer | None,
        toParent: Integer | None
      ): MessageResponse
      +delete(categoryId: Integer): MessageResponse
      +search(query: CategoryQuery): CategoryResponse
      +getScript(categoryId: Integer): MessageResponse<Script>
      +updateScript(categoryId: Integer, script: Script | None): MessageResponse
    }

    class IntentionController {
      +create(intention: IntentionEdit): MessageResponse
      +update(intentionId: Integer, intention: IntentionEdit): MessageResponse<Intention>
      +delete(intentionId: Integer): MessageResponse

      +createProject(intention: IntentionEdit): MessageResponse
      +updateProject(intentionId: Integer, intention: IntentionEdit): MessageResponse<Intention>
      +deleteProject(intentionId: Integer): MessageResponse

      +acceptProject(intentionId: Integer): MessageResponse
      +declineProject(intentionId: Integer): MessageResponse
      
      +search(query: IntentionQuery): IntentionResponse
    }

    class DigitizationListsController {
      +create(query: DocumentQuery): MessageResponse<Task>
      +delete(digitizationListId: Integer): MessageResponse<Task>
      +addDocuments(digitizationListId: Integer, query: DocumentQuery): MessageResponse<Task>
      +removeDocuments(digitizationListId: Integer, query: DocumentQuery): MesageResponse<Task>
      +search(query: DigitizationListQuery): DigitizationListResponse
    }

    class TaskController {
      +searchTasks(query: TaskQuery): TaskResponse
      +searchTaskItems(query: TaskItemQuery): TaskItemResponse
      +searchPeriodicTasks(query: PeriodicTaskQuery): PeriodicTaskResponse
      +updatePeriodicTask(periodicTaskId: Integer, name: String, period: TaskPeriod): PeriodicTask
      +deletePeriodicTask(periodicTaskId: Integer): MessageResponse
    }

    class UserController {
      +getNotifications(): UserNotifications
      +getSettings(): UserSettings
      +saveSettings(settings: UserSettings): MessageResponse
    }

    class SystemController {
      +testEntityProperty(entityProperty: EntityProperty, recordId: Integer): String
      +createEntityProperty(entityProperty: EntityProperty): UpdateMessageResponse<EntityProperty>
      +updateEntityProperty(entityPropertyId: Integer, entityProperty: EntityProperty): UpdateMessageResponse<EntityProperty>
      +deleteEntityProperty(entityPropertyId: Integer): MessageResponse
      +getEntityProperties(): List<EntityProperty>

      +runTask(taskType: SystemTask.RecreateIndexes | SystemTask.GenerateBackup): Task
      +planPeriodicTask(taskType: SystemTask.RecreateIndexes | SystemTask.GenerateBackup): PeriodicTask
      +loadFromBackup(file: BinFile): Task

      +listBackups(): List<String>
      +downloadBackup(name: String): BinFile
    }
  }

  package "Security" {
    class Permission {}

    class OwnershipPermission {}
  }

  package "Services" {

    class EnqueueDocumentAdditionResult {
      +enqueued: Integer
      +alreadyEnqueued: Integer
    }

    class DeleteDocumentAdditionResult {
      +deleted: Integer
      +alreadyDeleted: Integer
    }

    class AcceptProposalResult {
      +accepted: Integer
      +acceptedDeclined: Integer
      +alreadyAccepted: Integer
    }

    class DeclineProposalResult {
      +declined: Integer
      +alreadyAccepted: Integer
      +alreadyDeclined: Integer
    }

    class DocumentAdditionService {
      +enqueue(additions: List<DocumentAddition>): EnqueueDocumentAdditionResult
      +restrictQuery(query: DocumentAdditionQuery, user: User): DocumentAdditionQuery
      +delete(query: DocumentAdditionQuery): DeleteDocumentAdditionResult
      +acceptProposal(query: DocumentAdditionQuery, categoryId: Integer): AcceptProposalResult
      +declineProposal(query: DocumentAdditionQuery): DeclineProposalResult
    }

    class DocumentAdditionTaskService {
      +processAdditions(): None
    }

    class DocumentService {
      +restrictQuery(query: DocumentQuery, user: User): DocumentQuery
      +generateExport(query: DocumentQuery): pd.Dataframe
      +planUpdatePropertyTask(query: DocumentQuery, propertyName: String, propertyValue: String): Task
      +planGenerateListTask(query: DocumentQuery, settings: GenerateDocumentListSettings): Task
      +planTask(query: DocumentQuery, task: DocumentTask): Task
    }

    class DocumentTaskService {
      +updateProperty(task: Task): None
      +remove(task: Task): None
      +declineDigitization(task: Task): None
      +cancelDigitizationDeclination(task: Task): None
      +generateList(task: Task): None
      +reindex(task: Task): None
      +syncDigitizationState(task: Task): None
      +predictPageCount(task: Task): None
    }

    class CatalogRecordService {
      +runTask(query: CatalogRecordQuery, taskType: CatalogRecordTask): Task
    }

    class CatalogRecordTaskService {
      +ignoreMissingAuthority(task: Task): None
      +reindex(task: Task): None
      +sync(task: Task): None
      +reevaluateDifferences(task: Task): None
    }

    class CategoryService {
      +updateScript(categoryId: Integer, script: Script | None): None
    }

    class CategoryTaskService {
      +addDocumentsUsingScript(task: Task): None
    }

    class UserService {
      +getNotifications(): UserNotifications
    }

    class SystemService {
      +testEntityProperty(EntityProperty):
      +createEntityProperty(EntityProperty):
      +updateEntityProperty(EntityPropertyId):
      +deleteEntityProperty(Entity, EntityPropertyId):
      +getEntityProperties(query: EntityProp)
    }

    class SystemTask {
      +recreateIndexes(): Task
      +generateBackup(filename: String): Task
      +loadFromBackup(file: BinFile): Task
    }

    class WorkerService {
      +runTask(taskId: Integer): None
      +runPeriodicTask(periodicTaskId: Integer): None
    }
  }

  package "Types" {
    enum IdentifierType {
      Barcode
      SystemNumber
      ISXN
      Signature
    }

    enum DocumentsTask {
      UpdateProperty
      Remove
      DeclineDigitization
      CancelDigitizationDeclination
      GenerateDigitizationList
      Reindex
      SyncDigitizationState
      SyncCatalogRecord
      PredictPageCount
    }

    enum CatalogRecordsTask {
      IgnoreMissingAuthority
      Reindex
      Sync
      ReevaluateDifferences
    }

    enum CategoriesTask {
      AddDocumentsUsingScript
    }

    enum SystemTask {
      RecreateIndexes
      GenerateBackup
      LoadFromBackup
    }
  }

  package "Repositories" {

    package "Model" {
      class DocumentAddition {
        +identifierType: Enum<IdentifierType>
        +identifierValue: String
        +owner: String
        +filename: String | None = None
        +category: Integer
        +priority: Integer [1-5] = 3
        +ignoreDigitizationState: Boolean = False
        +addAgainIfPresent: Boolean = False
      }

      class CatalogRecord {
        +id: String
        +base: String
        +systemNumber: String
        +marc: Binary
        +unreachable: Boolean = False
        +addedAt: Timestamp
        +updatedAt: Timestamp
        +hasAddedDocuments(): Boolean
        +hasActiveDocuments(): Boolean
        +isValid(): Boolean
        +authoritiesRecordIds(): List<String>
        +authoritiesMarc(): List<Marc>
        +authoritiesDifference(): List<MarcDifference>
        +authoritiesDifferenceFlags(): List<DifferenceFlag>
      }

      class CatalogRecordAuthority {
        +mainId: String
        +authorityBase: String
        +isValid: Boolean = True
        +hasDifferences: Boolean = False
        +authorityId: String | None = None
      }

      class CatalogRecordDifference {
        +id: Integer
        +mainId: String
        +authorityId: String
      }

      class Document {
        +id: Integer
        +recordId: String
        +barcode: String | None
        +volume: String | None
        +volume_year: String | None
        +bundle: String | None
        +iteration: Integer | None
        +issuanceType: Enum<IssuanceType>
        +added_at: Timestamp = now
        +added_by: String
        +categoryId: Integer
        +pageCountCatalog: Integer | None
        +pageCountPredicted: Integer | None
        +pageCountManual: Integer | None
        +priority: Integer [1-5]
        +digitizationListId: Integer | None
        +pageCount(): Integer | None
        +isExtractable(): Boolean
        +categoryName(): String
        +categoryIds(): List<Integer>
        +extractedBy(): String | None
        +extractedAt(): String | None
      }

      class Category {
        +id: Integer
        +name: String
        +descripton: String | None
        +parentId: Integer | None = None
        +level: Integer = 0
        +assignable: Boolean = False
        +extractWhole: Boolean = False
        +disabled: Boolean = False
        +archived: Boolean = False
        +sourceTask: BashScriptFile | None = None
        +directlyAssignedTo: List<GroupName> | List<UserName> | None = None
        +assignedTo(): List<GroupName> | List<UserName> | None = None
        +totalPageCount(): Integer
        +totalDocuments(): Integer
        +extractablePageCount(): Integer
        +extractableDocuments(): Integer
        +extractedPageCount(): Integer
        +extractedDocuments(): Integer
      }

      class Connector {
        +name: String
                
      }

      class EntityProperty {
        +id: Integer
        +entity: 
        +name: String
        +translations: JSON
        +parseScript: ParseScript
      }

      class CategoriesDistribution {
        +id: Integer
        +name: String
        +active: Boolean
      }

      class CategoryDistribution {
        +categoryId: Integer
        +distributionId: Integer
        +percentage: Float
      }
    }

    class DocumentAdditionRepository {
      +get():
      +save():
      +index():
      +search(DocumentAdditionsQuery): DocumentAdditionsResponse
    }

    class DocumentRepository {
      +get():
      +save():
      +index():
      +search(DocumentQuery): DocumentsResponse
    }

    class CatalogRecordsRepository {
      +get():
      +save():
      +index():
      +search(CatalogRecordsQuery): CatalogRecordsResponse
    }

    class CategoriesRepository {
      +get():
      +save():
      +index():
      +search(CategoriesQuery): CategoriesResponse
    }
  }

  "API Controllers" --> "Security": Enforces permissions
  "API Controllers" --> "Services": Uses
  "API Controllers" --> "Repositories": Uses
  "Services" --> "Repositories": Uses
}

package "Digitization Registry" {
  class Controller {
    +getRecord(DocumentId, DocumentIdentifiers): List[State, Source]
    +updateState(DocumentId, State): void
  }
}

package "MARC Comparator" {
  class Controller {
    +compare(Record, Record): List[MARCDifferences]
    +loadFromArchive(ArchiveFile, MappingFile): void
  }

  class Service {
    +compare(Record, Record): List[MARCDifferences]
    +loadFromArchive(ArchiveFile, MappingFile): void
  }

  class Repository {
    +saveArchive(ArchiveFile): void
    +saveMapping(MappingFile): void
    +saveComparison(): void
    +loadComparison(): void
  }

  Controller --> Service : Uses
  Service --> Repository : Uses
}

' Dependencies

