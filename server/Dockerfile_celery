# Use an official Python runtime as a parent image
FROM python:3.12-slim

# Set the working directory to /app
WORKDIR /app

# Install any needed packages specified in requirements.txt
COPY requirements_celery.txt /app/
RUN pip install --no-cache-dir -r requirements_celery.txt

# Copy the current directory contents into the container at /app
COPY models /app/models
COPY procedures /app/procedures
COPY schemas /app/schemas
COPY services/csv_writer.py /app/services/csv_writer.py
COPY services/database.py /app/services/database.py
COPY services/exceptions.py /app/services/exceptions.py
COPY services/extractions_generator /app/services/extractions_generator
COPY services/predictions /app/services/predictions
COPY tasks /app/tasks
COPY worker.py /app


# Define environment variable

# Run app.py when the container launches
CMD ["celery", "-A", "worker", "worker", "--loglevel=info", "--uid=nobody"]

